<Project>
    <!-- Shared Avalonia package versions for Ui + Tests (bump here, not per csproj). -->
    <PropertyGroup>
        <AvaloniaVersion>12.1.2</AvaloniaVersion>
        <AvaloniaEditVersion>12.0.0</AvaloniaEditVersion>
        <AvaloniaDiagnosticsSupportVersion>2.2.3</AvaloniaDiagnosticsSupportVersion>
    </PropertyGroup>

    <!-- Optional: dotnet build -p:BETA=true adds BETA for #if branding (expiry enforcement is always on). -->
    <PropertyGroup Condition="'$(BETA)' == 'true'">
        <DefineConstants>$(DefineConstants);BETA</DefineConstants>
    </PropertyGroup>
</Project>
