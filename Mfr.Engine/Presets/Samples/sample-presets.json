{
  "presets": [
    {
      "id": "10000000-0000-4000-8000-000000000001",
      "name": "Beautify Names",
      "description": "Beautify file names by fixing casing and spaces",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "SpaceCharacter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "spaceCharacter": " ",
                "replacements": [
                  "%20",
                  "_"
                ]
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "SpaceAround",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "aroundChars": "-",
                "onlyWhenNeighboringAreLettersOrDigits": true
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "SpaceAfter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "afterChars": ",;!",
                "onlyWhenNextIsLetterOrDigit": true
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "ShrinkSpaces",
              "target": {
                "targetType": "FilePrefix"
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "StripSpacesRight",
              "target": {
                "targetType": "FilePrefix"
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "StripSpacesLeft",
              "target": {
                "targetType": "FilePrefix"
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "LettersCase",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "mode": "Capitalize",
                "capitalizeSkipWords": [
                  "a",
                  "an",
                  "the",
                  "and",
                  "or",
                  "of",
                  "to",
                  "in",
                  "on",
                  "for",
                  "with"
                ],
                "weirdUppercaseChancePercent": 50,
                "weirdFixedPlaces": false
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "CapitalizeAfter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "capitalizeAfterChars": ",!()[]{};-"
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "UppercaseInitials",
              "target": {
                "targetType": "FilePrefix"
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "CasingList",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "words": [
                  "a",
                  "an",
                  "the",
                  "and",
                  "or",
                  "of",
                  "to",
                  "in",
                  "on",
                  "for",
                  "with"
                ],
                "uppercaseSentenceInitial": true
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000002",
      "name": "Counter Prefix",
      "description": "Adds a number before each item in Rename List.",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "Counter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "start": 1,
                "step": 1,
                "leadingZerosMode": "Custom",
                "customLength": 2,
                "position": "Prepend",
                "separator": " - ",
                "resetPerFolder": false
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000003",
      "name": "Tags from Filename",
      "description": "Set ID3 tags for MP3 files according to filenames.\nFilename format should be: Track - Title.mp3\nParent folder name format should be: Artist - Album",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "TagRemover",
              "options": {
                "blocks": [
                  "id3v1",
                  "id3v2"
                ]
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "AudioTagSetter",
              "options": {
                "performers": {
                  "text": "<token:tokenNumber=1,separator=-,includeNext=false,includePrev=false,source=<parent-folder:1>>"
                },
                "album": {
                  "text": "<token:tokenNumber=2,separator=-,includeNext=true,includePrev=false,source=<parent-folder:1>>"
                },
                "title": {
                  "text": "<token:tokenNumber=2,separator=-,includeNext=true,includePrev=false,source=<file-name>>"
                },
                "track": {
                  "text": "<token:tokenNumber=1,separator=-,includeNext=false,includePrev=false,source=<file-name>>"
                },
                "trackAutoIncrement": false
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "Id3v2FieldSetter",
              "options": {
                "frameId": "TRCK",
                "text": "<audio-track>/<item-count>",
                "onlyIfEmpty": false
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000004",
      "name": "Artist - Track - Title",
      "description": "Set track titles for MP3 files from ID3 tag.\nFormat: Artist - Track Number - Track Title.mp3",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "Formatter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "template": "<audio-track>"
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "FixLeadingZeros",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "width": 2,
                "removeExtraZeros": true,
                "maxCount": 1,
                "wholeWordOnly": true
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "Inserter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "text": " - <audio-title>",
                "position": 1,
                "startFrom": "End",
                "overwrite": false
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "Inserter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "text": "<audio-artist> - ",
                "position": 1,
                "startFrom": "Beginning",
                "overwrite": false
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000005",
      "name": "Date Taken Prefix",
      "description": "Rename JPEG digital images according to date picture taken.",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "Formatter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "template": "<exif-date:yyyy-MM-dd HH-mm-ss> - <file-name>"
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000006",
      "name": "Name from Image",
      "description": "Set filename according to basic image properties",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "Formatter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "template": "<counter:initial=1,step=1,padding=fixed,length=2,resetScope=global>.<image-width>x<image-height>.<image-format>.<image-bit-depth>bpp.<image-horz-res>dpi"
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000007",
      "name": "Flatten Path",
      "description": "Use path name as file name.\nPath hierarchies (\\) are separated by periods (.)\nE.g: c:\\pictures\\David\\sep04\\pic1.jpg -->\npictures.David.sep04.pic1.jpg",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "Formatter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "template": "<parent-folder:3>.<parent-folder:2>.<parent-folder:1>.<file-name>"
              }
            }
          },
          {
            "enabled": false,
            "filter": {
              "type": "PathMover",
              "options": {
                "rootFolder": "C:\\",
                "subFolder": "Renamed Files"
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000008",
      "name": "Date Taken Folders",
      "description": "Move photos into folders by date taken (year\\month\\day).\nEdit the Path Mover root (default C:\\Photos) before Apply.",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "PathMover",
              "options": {
                "rootFolder": "C:\\Photos",
                "subFolder": "<exif-date:yyyy>\\<exif-date:MM>\\<exif-date:dd>"
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000009",
      "name": "Artist Album Folders",
      "description": "Move audio files into Artist\\Album folders from tags.\nEdit the Path Mover root (default C:\\Music) before Apply.",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "PathMover",
              "options": {
                "rootFolder": "C:\\Music",
                "subFolder": "<audio-artist>\\<audio-album>"
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000010",
      "name": "Swap Around Hyphen",
      "description": "Swap the two parts of a name separated by \" - \".\nE.g: Title - Artist --> Artist - Title",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "TokenMover",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "delimiter": " - ",
                "tokenNumber": 2,
                "moveBy": -1
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000011",
      "name": "Safe Filename",
      "description": "Replace Windows-illegal filename characters \\ / : * ? \" < > | with a hyphen.",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "Replacer",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "find": "[\\\\/:*?\"<>|]",
                "replacement": "-",
                "match": {
                  "mode": "Regex",
                  "caseSensitive": true,
                  "replaceAll": true,
                  "wholeWord": false
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000012",
      "name": "Strip Bracket Junk",
      "description": "Remove (…) and […] segments from the name, then shrink leftover spaces.\nE.g: Song (Official Video) [HD] --> Song",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "StripParentheses",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "type": "Round",
                "removeContents": true
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "StripParentheses",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "type": "Square",
                "removeContents": true
              }
            }
          },
          {
            "enabled": true,
            "filter": {
              "type": "ShrinkSpaces",
              "target": {
                "targetType": "FilePrefix"
              }
            }
          }
        ]
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000013",
      "name": "Year - Title from Tags",
      "description": "Set the name from audio tags as Year - Title.",
      "chain": {
        "steps": [
          {
            "enabled": true,
            "filter": {
              "type": "Formatter",
              "target": {
                "targetType": "FilePrefix"
              },
              "options": {
                "template": "<audio-year> - <audio-title>"
              }
            }
          }
        ]
      }
    }
  ]
}
