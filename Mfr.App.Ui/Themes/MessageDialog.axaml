<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared OK / Cancel footer chrome (ModalOkCancelFooter and remaining hand-rolled footers). -->
  <Style Selector="Button.message-dialog-footer">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.message-dialog-footer[IsDefault=True]">
    <Setter Property="Background" Value="{DynamicResource AppChromeSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSelectionBorderBrush}" />
  </Style>
  <Style Selector="Button.message-dialog-footer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppChromeHoverBrush}" />
  </Style>
</Styles>
