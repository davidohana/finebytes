<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppChromeSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppChromeAltSurfaceBrush" Color="#F6F6F6" />
      <SolidColorBrush x:Key="AppChromePanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppChromeHeaderBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="AppChromeHeaderForegroundBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="AppChromeSelectionBrush" Color="#B8DCFF" />
      <SolidColorBrush x:Key="AppChromeSelectionBorderBrush" Color="#7ABFFF" />
      <SolidColorBrush x:Key="AppChromeHoverBrush" Color="#E8E8E8" />
      <SolidColorBrush x:Key="AppChromeSeparatorBrush" Color="#E0E0E0" />
      <SolidColorBrush x:Key="AppChromeForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="AppChromeBorderBrush" Color="#D0D0D0" />
      <SolidColorBrush x:Key="AppChromeMutedForegroundBrush" Color="#5C5C5C" />
      <SolidColorBrush x:Key="AppChromeSortGlyphForegroundBrush" Color="#6E6E6E" />
      <SolidColorBrush x:Key="AppChromeSortGlyphBackgroundBrush" Color="#ECECEC" />
      <SolidColorBrush x:Key="AppChromeSortGlyphBorderBrush" Color="#D8D8D8" />
      <!-- Shared error-red (status bar, preview glyph, Rename List row error path). -->
      <SolidColorBrush x:Key="AppChromeErrorForegroundBrush" Color="#C00000" />
      <SolidColorBrush x:Key="AppChromePreviewGlyphBackgroundBrush" Color="#FFE8E8" />
      <SolidColorBrush x:Key="AppChromePreviewGlyphBorderBrush" Color="#F0A0A0" />
      <SolidColorBrush x:Key="DropMarkBrush" Color="#FA8072" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppChromeSurfaceBrush" Color="#202020" />
      <SolidColorBrush x:Key="AppChromeAltSurfaceBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="AppChromePanelBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="AppChromeHeaderBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="AppChromeHeaderForegroundBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="AppChromeSelectionBrush" Color="#264F78" />
      <SolidColorBrush x:Key="AppChromeSelectionBorderBrush" Color="#3A6A9A" />
      <SolidColorBrush x:Key="AppChromeHoverBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="AppChromeSeparatorBrush" Color="#3F3F3F" />
      <SolidColorBrush x:Key="AppChromeForegroundBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="AppChromeBorderBrush" Color="#3F3F3F" />
      <SolidColorBrush x:Key="AppChromeMutedForegroundBrush" Color="#B0B0B0" />
      <SolidColorBrush x:Key="AppChromeSortGlyphForegroundBrush" Color="#A8A8A8" />
      <SolidColorBrush x:Key="AppChromeSortGlyphBackgroundBrush" Color="#383838" />
      <SolidColorBrush x:Key="AppChromeSortGlyphBorderBrush" Color="#454545" />
      <SolidColorBrush x:Key="AppChromeErrorForegroundBrush" Color="#FF8080" />
      <SolidColorBrush x:Key="AppChromePreviewGlyphBackgroundBrush" Color="#4A2828" />
      <SolidColorBrush x:Key="AppChromePreviewGlyphBorderBrush" Color="#804040" />
      <SolidColorBrush x:Key="DropMarkBrush" Color="#FA8072" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
