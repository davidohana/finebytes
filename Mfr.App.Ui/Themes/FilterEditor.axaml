<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:AvaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:fe="using:Mfr.App.Ui.Views.FormatEditor"
>
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="FilterEditorTitleBarBrush" Color="#0066B8" />
          <SolidColorBrush x:Key="FilterEditorTitleBarForegroundBrush" Color="#FFFFFF" />
          <!-- Shown at TextControlPlaceholderOpacity (0.5); keep base color soft. -->
          <SolidColorBrush x:Key="FilterEditorWatermarkBrush" Color="#A8A8A8" />
          <SolidColorBrush x:Key="FormatEditorErrorLinkForegroundBrush" Color="#C42B1C" />
          <!-- Soft zebra chips (selection blue stays visible); name accent not error red. -->
          <SolidColorBrush x:Key="FormatTokenBackgroundBrush" Color="#FFF6D5" />
          <SolidColorBrush x:Key="FormatTokenAltBackgroundBrush" Color="#E0F2E9" />
          <SolidColorBrush x:Key="FormatTokenNameForegroundBrush" Color="#2B6CB0" />
          <SolidColorBrush x:Key="FormatTokenNumberForegroundBrush" Color="#C05621" />
          <SolidColorBrush x:Key="FormatTokenErrorBackgroundBrush" Color="#40C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="FilterEditorTitleBarBrush" Color="#264F78" />
          <SolidColorBrush x:Key="FilterEditorTitleBarForegroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="FilterEditorWatermarkBrush" Color="#8A8A8A" />
          <SolidColorBrush x:Key="FormatEditorErrorLinkForegroundBrush" Color="#FF8080" />
          <SolidColorBrush x:Key="FormatTokenBackgroundBrush" Color="#4A4020" />
          <SolidColorBrush x:Key="FormatTokenAltBackgroundBrush" Color="#2A3A2E" />
          <SolidColorBrush x:Key="FormatTokenNameForegroundBrush" Color="#6CB6FF" />
          <SolidColorBrush x:Key="FormatTokenNumberForegroundBrush" Color="#F6AD55" />
          <SolidColorBrush x:Key="FormatTokenErrorBackgroundBrush" Color="#66C42B1C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- x:Shared=False: each ComboBox needs its own tip visual (one parent). -->
      <controls:RichToolTip x:Key="TimestampFieldComboTip" x:Shared="False">
        <TextBlock Classes="rich-tip-bullet" Text="• Creation: file/folder creation time." />
        <TextBlock Classes="rich-tip-bullet" Text="• Last Write: last modified time." />
        <TextBlock Classes="rich-tip-bullet" Text="• Last Access: last accessed time." />
      </controls:RichToolTip>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.filter-editor-title-bar">
    <Setter Property="Background" Value="{DynamicResource FilterEditorTitleBarBrush}" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="6,0,4,0" />
  </Style>
  <Style Selector="TextBlock.filter-editor-title-bar">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource FilterEditorTitleBarForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.filter-editor-label">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.filter-editor-hint">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="HyperlinkButton.filter-editor-hint-link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="TextBox.filter-editor-field, ComboBox.filter-editor-field, TextBox.filter-editor-field-wrap">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.filter-editor-field, ComboBox.filter-editor-field">
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.filter-editor-field[IsReadOnly=True], TextBox.filter-editor-field-wrap[IsReadOnly=True]">
    <Setter Property="Background" Value="{DynamicResource AppChromeAltSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeMutedForegroundBrush}" />
  </Style>
  <Style
    Selector="TextBox.filter-editor-field[IsReadOnly=True] /template/ Border#PART_BorderElement,
              TextBox.filter-editor-field-wrap[IsReadOnly=True] /template/ Border#PART_BorderElement,
              TextBox.filter-editor-field[IsReadOnly=True]:pointerover /template/ Border#PART_BorderElement,
              TextBox.filter-editor-field[IsReadOnly=True]:focus /template/ Border#PART_BorderElement,
              TextBox.filter-editor-field-wrap[IsReadOnly=True]:pointerover /template/ Border#PART_BorderElement,
              TextBox.filter-editor-field-wrap[IsReadOnly=True]:focus /template/ Border#PART_BorderElement"
  >
    <Setter Property="Background" Value="{DynamicResource AppChromeAltSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
  </Style>
  <Style Selector="Button.filter-editor-button">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.format-editor-tool">
    <Setter Property="Width" Value="22" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.format-editor-field-frame">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.format-editor-field-frame.format-editor-active-target">
    <Setter Property="BorderBrush" Value="{DynamicResource FilterEditorTitleBarBrush}" />
  </Style>
  <Style Selector="Border.format-token-picker-pane">
    <Setter Property="Background" Value="{DynamicResource AppChromeAltSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <!-- Pane-edge grip: taller than tool buttons so it reads as collapse, not a header peer of Edit. -->
  <Style Selector="Button.format-token-collapse-grip">
    <Setter Property="Width" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.filter-editor-field">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.filter-editor-field-wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox.format-string-field">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFixedWidthFont}" />
  </Style>
  <Style Selector="AvaloniaEdit|TextEditor.format-string-field">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFixedWidthFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="fe|FormatEditor[IsReadOnly=True] AvaloniaEdit|TextEditor.format-string-field">
    <Setter Property="Background" Value="{DynamicResource AppChromeAltSurfaceBrush}" />
  </Style>
  <Style Selector="TextBlock.format-editor-watermark">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFixedWidthFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FilterEditorWatermarkBrush}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Margin" Value="8,6,8,0" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ComboBox.format-string-field">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFixedWidthFont}" />
  </Style>
  <Style Selector="ComboBox.format-string-field /template/ TextBox#PART_EditableTextBox">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFixedWidthFont}" />
  </Style>
  <Style Selector="ComboBox.filter-editor-field">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.filter-editor-field /template/ ContentPresenter#ContentPresenter">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ComboBox.filter-editor-field /template/ TextBox#PART_EditableTextBox">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <!--
    Watermarks look like filled values at rest. Hide unless the empty field is focused.
    Foreground (not Opacity): PART_Watermark Opacity is a template local DynamicResource.
  -->
  <Style
    Selector="TextBox.filter-editor-field /template/ TextBlock#PART_Watermark,
              TextBox.filter-editor-field-wrap /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field /template/ TextBox#PART_EditableTextBox /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field /template/ TextBlock#PlaceholderTextBlock"
  >
    <Setter Property="Foreground" Value="Transparent" />
  </Style>
  <Style
    Selector="TextBox.filter-editor-field:pointerover /template/ TextBlock#PART_Watermark,
              TextBox.filter-editor-field-wrap:pointerover /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field:pointerover /template/ TextBox#PART_EditableTextBox /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field:pointerover /template/ TextBlock#PlaceholderTextBlock"
  >
    <Setter Property="Foreground" Value="Transparent" />
  </Style>
  <Style
    Selector="TextBox.filter-editor-field:focus /template/ TextBlock#PART_Watermark,
              TextBox.filter-editor-field-wrap:focus /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field /template/ TextBox#PART_EditableTextBox:focus /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field:focus /template/ TextBlock#PlaceholderTextBlock"
  >
    <Setter Property="Foreground" Value="{DynamicResource FilterEditorWatermarkBrush}" />
  </Style>

  <Style Selector="Button.format-editor-error-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FormatEditorErrorLinkForegroundBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.format-editor-error-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Insert-picker search should keep its hint; option fields hide watermarks until focus. -->
  <Style
    Selector="TextBox.format-token-search /template/ TextBlock#PART_Watermark,
              TextBox.format-token-search:pointerover /template/ TextBlock#PART_Watermark,
              TextBox.format-token-search:focus /template/ TextBlock#PART_Watermark"
  >
    <Setter Property="Foreground" Value="{DynamicResource FilterEditorWatermarkBrush}" />
  </Style>

  <Style Selector="TreeView.format-token-picker">
    <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style Selector="TreeView.format-token-picker TreeViewItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
  </Style>
  <Style Selector="TreeView.format-token-picker TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="TreeView.format-token-picker TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>
  <Style Selector="TreeView.format-token-picker TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppChromeHoverBrush}" />
  </Style>
  <Style Selector="TreeView.format-token-picker TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AppChromeSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSelectionBorderBrush}" />
  </Style>
  <Style
    Selector="TreeView.format-token-picker TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover,
              TreeView.format-token-picker TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot"
  >
    <Setter Property="Background" Value="{DynamicResource AppChromeSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSelectionBorderBrush}" />
  </Style>
  <Style Selector="TreeView.format-token-picker TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
  </Style>
  <Style Selector="TreeView.format-token-picker TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TreeView.format-token-picker TextBlock.format-token-group">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.rich-tip-title">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.rich-tip-body, TextBlock.rich-tip-bullet">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
