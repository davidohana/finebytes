<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
>
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="FilterEditorTitleBarBrush" Color="#0066B8" />
          <SolidColorBrush x:Key="FilterEditorTitleBarForegroundBrush" Color="#FFFFFF" />
          <!-- Shown at TextControlPlaceholderOpacity (0.5); keep base color soft. -->
          <SolidColorBrush x:Key="FilterEditorWatermarkBrush" Color="#A8A8A8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="FilterEditorTitleBarBrush" Color="#264F78" />
          <SolidColorBrush x:Key="FilterEditorTitleBarForegroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="FilterEditorWatermarkBrush" Color="#8A8A8A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- x:Shared=False: each ComboBox needs its own tip visual (one parent). -->
      <controls:RichToolTip x:Key="TimestampFieldComboTip" x:Shared="False">
        <TextBlock Classes="rich-tip-bullet" Text="• Creation: file/folder creation time." />
        <TextBlock Classes="rich-tip-bullet" Text="• Last Write: last modified time." />
        <TextBlock Classes="rich-tip-bullet" Text="• Last Access: last accessed time." />
      </controls:RichToolTip>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.filter-editor-title-bar">
    <Setter Property="Background" Value="{DynamicResource FilterEditorTitleBarBrush}" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="6,0,4,0" />
  </Style>
  <Style Selector="TextBlock.filter-editor-title-bar">
    <Setter Property="FontFamily" Value="{DynamicResource FileListFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FileListFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource FilterEditorTitleBarForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.filter-editor-label">
    <Setter Property="FontFamily" Value="{DynamicResource FileListFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FileListFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.filter-editor-hint">
    <Setter Property="FontFamily" Value="{DynamicResource FileListFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FileListFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="TextBox.filter-editor-field, ComboBox.filter-editor-field, TextBox.filter-editor-field-wrap">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontFamily" Value="{DynamicResource FileListFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FileListFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.filter-editor-field, ComboBox.filter-editor-field">
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.filter-editor-button">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontFamily" Value="{DynamicResource FileListFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FileListFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.filter-editor-field">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.filter-editor-field-wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="ComboBox.filter-editor-field">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.filter-editor-field /template/ ContentPresenter#ContentPresenter">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ComboBox.filter-editor-field /template/ TextBox#PART_EditableTextBox">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <!--
    Watermarks look like filled values at rest. Hide unless the empty field is focused.
    Foreground (not Opacity): PART_Watermark Opacity is a template local DynamicResource.
  -->
  <Style
    Selector="TextBox.filter-editor-field /template/ TextBlock#PART_Watermark,
              TextBox.filter-editor-field-wrap /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field /template/ TextBox#PART_EditableTextBox /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field /template/ TextBlock#PlaceholderTextBlock"
  >
    <Setter Property="Foreground" Value="Transparent" />
  </Style>
  <Style
    Selector="TextBox.filter-editor-field:pointerover /template/ TextBlock#PART_Watermark,
              TextBox.filter-editor-field-wrap:pointerover /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field:pointerover /template/ TextBox#PART_EditableTextBox /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field:pointerover /template/ TextBlock#PlaceholderTextBlock"
  >
    <Setter Property="Foreground" Value="Transparent" />
  </Style>
  <Style
    Selector="TextBox.filter-editor-field:focus /template/ TextBlock#PART_Watermark,
              TextBox.filter-editor-field-wrap:focus /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field /template/ TextBox#PART_EditableTextBox:focus /template/ TextBlock#PART_Watermark,
              ComboBox.filter-editor-field:focus /template/ TextBlock#PlaceholderTextBlock"
  >
    <Setter Property="Foreground" Value="{DynamicResource FilterEditorWatermarkBrush}" />
  </Style>

  <Style Selector="TextBlock.rich-tip-title">
    <Setter Property="FontFamily" Value="{DynamicResource FileListFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FileListFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.rich-tip-body, TextBlock.rich-tip-bullet">
    <Setter Property="FontFamily" Value="{DynamicResource FileListFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FileListFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
