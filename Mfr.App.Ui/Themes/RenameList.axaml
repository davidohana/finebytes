<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RenameListMissingOnDiskForegroundBrush" Color="#808080" />
          <SolidColorBrush x:Key="RenameListMissingOnDiskSelectedForegroundBrush" Color="#555555" />
          <SolidColorBrush x:Key="RenameListRowErrorGlyphForegroundBrush" Color="#C00000" />
          <SolidColorBrush x:Key="RenameListPreviewChangedForegroundBrush" Color="#FF0000" />
          <SolidColorBrush x:Key="RenameListManualOverrideForegroundBrush" Color="#0000FF" />
          <SolidColorBrush x:Key="RenameListManualOverrideSelectedForegroundBrush" Color="#00008B" />
          <SolidColorBrush x:Key="RenameListPreviewErrorRowBrush" Color="#FFF0F5" />
          <!-- Lighter than MFR7 Plum (#DDA0DD) so black/red cell text stays readable. -->
          <SolidColorBrush x:Key="RenameListCommitErrorRowBrush" Color="#F2D9F2" />
          <!-- Amber: stronger than row selection blue, readable under red/blue cell text. -->
          <SolidColorBrush x:Key="RenameListFocusedCellBrush" Color="#FFE08A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RenameListMissingOnDiskForegroundBrush" Color="#909090" />
          <SolidColorBrush x:Key="RenameListMissingOnDiskSelectedForegroundBrush" Color="#C0C0C0" />
          <SolidColorBrush x:Key="RenameListRowErrorGlyphForegroundBrush" Color="#FF8080" />
          <SolidColorBrush x:Key="RenameListPreviewChangedForegroundBrush" Color="#FF8080" />
          <SolidColorBrush x:Key="RenameListManualOverrideForegroundBrush" Color="#8090FF" />
          <SolidColorBrush x:Key="RenameListManualOverrideSelectedForegroundBrush" Color="#B0C0FF" />
          <SolidColorBrush x:Key="RenameListPreviewErrorRowBrush" Color="#4A3038" />
          <SolidColorBrush x:Key="RenameListCommitErrorRowBrush" Color="#6B5068" />
          <SolidColorBrush x:Key="RenameListFocusedCellBrush" Color="#8A6A20" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.rename-list-preview-glyph">
    <Setter Property="Background" Value="{DynamicResource AppChromePreviewGlyphBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromePreviewGlyphBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.rename-list-preview-glyph TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeSortGlyphFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromePreviewGlyphForegroundBrush}" />
  </Style>
  <Style Selector="Border.rename-list-sort-glyph">
    <Setter Property="Background" Value="{DynamicResource AppChromeSortGlyphBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSortGlyphBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.rename-list-sort-glyph TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource AppChromeSortGlyphFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource AppChromeSortGlyphForegroundBrush}" />
  </Style>
</Styles>
