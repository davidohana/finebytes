<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="FileListRowBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FileListAltRowBrush" Color="#F6F6F6" />
      <SolidColorBrush x:Key="FileListSelectionBrush" Color="#B8DCFF" />
      <SolidColorBrush x:Key="FileListSelectionBorderBrush" Color="#7ABFFF" />
      <SolidColorBrush x:Key="FileListHoverBrush" Color="#E8E8E8" />
      <SolidColorBrush x:Key="FileListHeaderBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="FileListHeaderForegroundBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="FileListSeparatorBrush" Color="#E0E0E0" />
      <SolidColorBrush x:Key="FileListForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="FileListAddressBarBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FileListAddressBarBorderBrush" Color="#D0D0D0" />
      <SolidColorBrush x:Key="FileListBreadcrumbMutedBrush" Color="#5C5C5C" />
      <SolidColorBrush x:Key="FileListSortGlyphForegroundBrush" Color="#6E6E6E" />
      <SolidColorBrush x:Key="FileListSortGlyphBackgroundBrush" Color="#ECECEC" />
      <SolidColorBrush x:Key="FileListSortGlyphBorderBrush" Color="#D8D8D8" />
      <SolidColorBrush x:Key="FileListPreviewGlyphForegroundBrush" Color="#C00000" />
      <SolidColorBrush x:Key="FileListPreviewGlyphBackgroundBrush" Color="#FFE8E8" />
      <SolidColorBrush x:Key="FileListPreviewGlyphBorderBrush" Color="#F0A0A0" />
      <SolidColorBrush x:Key="RenameListDropIndicatorBrush" Color="#FA8072" />
      <SolidColorBrush x:Key="RenameListMissingOnDiskForegroundBrush" Color="#808080" />
      <SolidColorBrush x:Key="RenameListRowErrorGlyphForegroundBrush" Color="#C00000" />
      <SolidColorBrush x:Key="FilterEditorTitleBarBrush" Color="#0066B8" />
      <SolidColorBrush x:Key="FilterEditorTitleBarForegroundBrush" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="FileListRowBrush" Color="#202020" />
      <SolidColorBrush x:Key="FileListAltRowBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="FileListSelectionBrush" Color="#264F78" />
      <SolidColorBrush x:Key="FileListSelectionBorderBrush" Color="#3A6A9A" />
      <SolidColorBrush x:Key="FileListHoverBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="FileListHeaderBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="FileListHeaderForegroundBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="FileListSeparatorBrush" Color="#3F3F3F" />
      <SolidColorBrush x:Key="FileListForegroundBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="FileListAddressBarBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="FileListAddressBarBorderBrush" Color="#3F3F3F" />
      <SolidColorBrush x:Key="FileListBreadcrumbMutedBrush" Color="#B0B0B0" />
      <SolidColorBrush x:Key="FileListSortGlyphForegroundBrush" Color="#A8A8A8" />
      <SolidColorBrush x:Key="FileListSortGlyphBackgroundBrush" Color="#383838" />
      <SolidColorBrush x:Key="FileListSortGlyphBorderBrush" Color="#454545" />
      <SolidColorBrush x:Key="FileListPreviewGlyphForegroundBrush" Color="#FF8080" />
      <SolidColorBrush x:Key="FileListPreviewGlyphBackgroundBrush" Color="#4A2828" />
      <SolidColorBrush x:Key="FileListPreviewGlyphBorderBrush" Color="#804040" />
      <SolidColorBrush x:Key="RenameListDropIndicatorBrush" Color="#FA8072" />
      <SolidColorBrush x:Key="RenameListMissingOnDiskForegroundBrush" Color="#909090" />
      <SolidColorBrush x:Key="RenameListRowErrorGlyphForegroundBrush" Color="#FF8080" />
      <SolidColorBrush x:Key="FilterEditorTitleBarBrush" Color="#264F78" />
      <SolidColorBrush x:Key="FilterEditorTitleBarForegroundBrush" Color="#F0F0F0" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
