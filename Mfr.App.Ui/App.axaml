<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Mfr.App.Ui.App"
  RequestedThemeVariant="Default"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/FileList.axaml" />
        <ResourceInclude Source="/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PaneChromeBrush" Color="#F0F0F0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PaneChromeBrush" Color="#2B2B2B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <x:Double x:Key="ScrollBarSize">12</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>
    <!-- Fluent paints rows under the vertical scrollbar (ColumnSpan=3). Keep a real gutter.
         Leave RowSpan=2 so V-bar width math still treats the bar as overlay. Header span is
         applied in DataGridScrollGutter (template local ColumnSpan cannot be styled). -->
    <Style Selector="DataGrid /template/ DataGridRowsPresenter#PART_RowsPresenter">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="TextBlock.pane-header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="8,6" />
    </Style>
    <Style Selector="Border.pane">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="Margin" Value="1" />
    </Style>
    <Style Selector=":is(GridSplitter)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="(Panel.ZIndex)" Value="1" />
    </Style>
    <Style Selector=":is(GridSplitter)[ResizeDirection=Columns]">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Rectangle x:Name="Hairline" Width="1" HorizontalAlignment="Center" Fill="Transparent" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector=":is(GridSplitter)[ResizeDirection=Rows]">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Rectangle x:Name="Hairline" Height="1" VerticalAlignment="Center" Fill="Transparent" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector=":is(GridSplitter):pointerover /template/ Rectangle#Hairline">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    </Style>
    <Style Selector="Button.rename-list-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rename-list-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.rename-list-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
    <Style Selector="Button.rename-list-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
    </Style>
    <Style Selector="Button.rename-list-action:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </Application.Styles>
</Application>
