<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mfr.App.Ui.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <Style Selector="TextBlock.pane-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,6" />
        </Style>
        <Style Selector="Border.pane">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector=":is(GridSplitter)">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="(Panel.ZIndex)" Value="1" />
        </Style>
        <Style Selector=":is(GridSplitter)[ResizeDirection=Columns]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Panel Width="2" HorizontalAlignment="Center">
                            <Rectangle x:Name="Shadow"
                                       Width="1"
                                       HorizontalAlignment="Left"
                                       Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                            <Rectangle x:Name="Highlight"
                                       Width="1"
                                       HorizontalAlignment="Right"
                                       Fill="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector=":is(GridSplitter)[ResizeDirection=Rows]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Panel Height="2" VerticalAlignment="Center">
                            <Rectangle x:Name="Shadow"
                                       Height="1"
                                       VerticalAlignment="Top"
                                       Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                            <Rectangle x:Name="Highlight"
                                       Height="1"
                                       VerticalAlignment="Bottom"
                                       Fill="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector=":is(GridSplitter):pointerover /template/ Rectangle#Shadow">
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
    </Application.Styles>
</Application>
