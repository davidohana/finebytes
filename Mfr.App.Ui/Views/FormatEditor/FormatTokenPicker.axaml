<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="280"
  d:DesignHeight="320"
  x:Class="Mfr.App.Ui.Views.FormatEditor.FormatTokenPicker"
  x:DataType="vm:FormatTokenPickerViewModel"
>
  <DockPanel>
    <controls:CatalogSearchBox
      x:Name="TokenSearchBox"
      DockPanel.Dock="Top"
      Margin="0,0,0,4"
      PlaceholderText="Search tokens…"
      Text="{Binding SearchText}"
      ClearCommand="{Binding ClearSearchCommand}"
      IsClearVisible="{Binding !IsGrouped}"
    />
    <TreeView x:Name="TokenList" Classes="format-token-picker" ItemsSource="{Binding VisibleItems}">
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FormatTokenPickerNode">
          <StackPanel Spacing="0" ToolTip.Tip="{Binding Entry.ShortDescription}">
            <TextBlock
              Text="{Binding Title}"
              TextTrimming="CharacterEllipsis"
              Classes.format-token-group="{Binding IsGroup}"
            />
            <TextBlock
              Text="{Binding Entry.GroupPath}"
              Opacity="0.7"
              FontSize="11"
              IsVisible="{Binding ShowGroupSubtitle}"
              TextTrimming="CharacterEllipsis"
            />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
