<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.ParentFolderFormatTokenEditorView"
  x:DataType="vm:ParentFolderFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Level:">
      <controls:CompactNumericUpDown
        Width="72"
        HorizontalAlignment="Left"
        Minimum="1"
        Maximum="99"
        Increment="1"
        FormatString="0"
        Value="{Binding Level}"
      />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
