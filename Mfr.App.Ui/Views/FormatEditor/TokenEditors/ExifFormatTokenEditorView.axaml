<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.ExifFormatTokenEditorView"
  x:DataType="vm:ExifFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6">
    <controls:FilterEditorLabeledRow Label="Source:">
      <ComboBox
        Classes="filter-editor-field"
        HorizontalAlignment="Stretch"
        ItemsSource="{Binding SourceAliases}"
        SelectedItem="{Binding Source}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Name / id:">
      <TextBox Classes="filter-editor-field" HorizontalAlignment="Stretch" Text="{Binding Name}" />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
