<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.ExifDateFormatTokenEditorView"
  x:DataType="vm:ExifDateFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6">
    <controls:FilterEditorLabeledRow Label="Format:">
      <ComboBox
        Classes="filter-editor-field format-string-field"
        HorizontalAlignment="Stretch"
        IsEditable="True"
        ItemsSource="{x:Static vm:DateFormatExamples.All}"
        Text="{Binding Format}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorHint
      x:Name="FormatDocsHint"
      LinkText="{x:Static vm:DateFormatExamples.DocsLinkText}"
      NavigateUri="{x:Static vm:DateFormatExamples.DocsUri}"
    />
  </StackPanel>
</UserControl>
