<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.ExifDateFormatTokenEditorView"
  x:DataType="vm:ExifDateFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Format:">
      <TextBox Classes="filter-editor-field" MinWidth="240" HorizontalAlignment="Stretch" Text="{Binding Format}" />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
