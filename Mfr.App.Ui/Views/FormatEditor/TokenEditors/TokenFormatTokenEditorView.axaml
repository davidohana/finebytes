<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.TokenFormatTokenEditorView"
  x:DataType="vm:TokenFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6">
    <controls:FilterEditorLabeledRow Label="Token number:">
      <controls:CompactNumericUpDown
        Minimum="1"
        Maximum="9999"
        Increment="1"
        FormatString="0"
        Value="{Binding TokenNumber}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Separator:">
      <TextBox Classes="filter-editor-field" Width="80" HorizontalAlignment="Left" Text="{Binding Separator}" />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="">
      <controls:CompactCheckBox Content="Include next" IsChecked="{Binding IncludeNext}" />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="">
      <controls:CompactCheckBox Content="Include previous" IsChecked="{Binding IncludePrev}" />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Source:">
      <TextBox Classes="filter-editor-field" HorizontalAlignment="Stretch" Text="{Binding Source}" />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
