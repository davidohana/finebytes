<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.SubstrFormatTokenEditorView"
  x:DataType="vm:SubstrFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Start:">
      <controls:CompactNumericUpDown
        Width="80"
        HorizontalAlignment="Left"
        Minimum="-9999"
        Maximum="9999"
        Increment="1"
        FormatString="0"
        Value="{Binding Start}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="End:">
      <controls:CompactNumericUpDown
        Width="80"
        HorizontalAlignment="Left"
        Minimum="-9999"
        Maximum="9999"
        Increment="1"
        FormatString="0"
        Value="{Binding End}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Source:">
      <TextBox Classes="filter-editor-field" MinWidth="240" HorizontalAlignment="Stretch" Text="{Binding Source}" />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
