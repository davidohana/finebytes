<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.Id3v2FormatTokenEditorView"
  x:DataType="vm:Id3v2FormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Frame:">
      <ComboBox
        Classes="filter-editor-field"
        MinWidth="260"
        HorizontalAlignment="Stretch"
        ItemsSource="{Binding Frames}"
        SelectedItem="{Binding SelectedFrame}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Description:" IsVisible="{Binding ShowsDescription}">
      <TextBox
        Classes="filter-editor-field"
        MinWidth="200"
        HorizontalAlignment="Stretch"
        Text="{Binding Description}"
      />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
