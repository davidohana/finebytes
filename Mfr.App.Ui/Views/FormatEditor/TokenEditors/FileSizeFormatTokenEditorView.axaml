<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.FormatEditor.TokenEditors.FileSizeFormatTokenEditorView"
  x:DataType="vm:FileSizeFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Unit:">
      <ComboBox
        Classes="filter-editor-field"
        Width="100"
        HorizontalAlignment="Left"
        ItemsSource="{x:Static vm:FileSizeFormatTokenEditorViewModel.UnitChoices}"
        SelectedItem="{Binding Unit}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Decimals:">
      <controls:CompactNumericUpDown
        Width="56"
        HorizontalAlignment="Left"
        Minimum="0"
        Maximum="6"
        Increment="1"
        FormatString="0"
        Value="{Binding Decimals}"
      />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
