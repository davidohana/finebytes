<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mfr.App.Ui.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="240"
             x:Class="Mfr.App.Ui.Views.RenameListView"
             x:DataType="vm:RenameListViewModel">
    <Border Classes="pane">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="pane-header" Text="Rename List" />
            <Border />
        </DockPanel>
    </Border>
</UserControl>
