<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.LogDialog"
  x:Class="Mfr.App.Ui.Views.LogDialog.RenameLogDialog"
  x:DataType="vm:RenameLogDialogViewModel"
  Title="Rename Log"
  Icon="/Assets/mfr.ico"
  Width="640"
  Height="420"
  MinWidth="480"
  MinHeight="320"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="True"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <DockPanel Margin="12">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Spacing="8"
      Margin="0,12,0,0"
    >
      <Button
        x:Name="CloseButton"
        Classes="message-dialog-footer"
        Content="Close"
        MinWidth="88"
        IsCancel="True"
        Command="{Binding CloseCommand}"
      />
    </StackPanel>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="180,4,*">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Available Logs:" FontWeight="SemiBold" Margin="0,0,0,8" />
      <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button
            x:Name="UndoButton"
            Classes="message-dialog-footer"
            Content="Undo"
            MinWidth="72"
            Command="{Binding UndoCommand}"
          />
          <Button
            x:Name="EraseButton"
            Classes="message-dialog-footer"
            Content="Erase"
            MinWidth="72"
            Command="{Binding EraseCommand}"
          />
        </StackPanel>
        <TextBlock Text="Log Details:" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>

      <ListBox
        x:Name="LogsList"
        Grid.Row="1"
        Grid.Column="0"
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding SelectedItem}"
        KeyDown="_OnLogsListKeyDown"
      >
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RenameLogListItem">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Width="4" />
      <TextBox
        x:Name="DetailsBox"
        Grid.Row="1"
        Grid.Column="2"
        Text="{Binding DetailsText}"
        IsReadOnly="True"
        AcceptsReturn="True"
        TextWrapping="NoWrap"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
      />
    </Grid>
  </DockPanel>
</Window>
