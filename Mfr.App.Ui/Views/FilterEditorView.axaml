<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels"
  mc:Ignorable="d"
  d:DesignWidth="480"
  d:DesignHeight="160"
  x:Class="Mfr.App.Ui.Views.FilterEditorView"
  x:DataType="vm:FilterEditorViewModel"
>
  <Border Classes="pane">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="pane-header" Text="Filter Configuration" />
      <TextBlock
        x:Name="AppliedFilterTitle"
        Margin="8,0,8,8"
        IsVisible="{Binding HasSelectedStep}"
        Text="{Binding TitleText}"
      />
    </DockPanel>
  </Border>
</UserControl>
