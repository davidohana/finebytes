<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.MainWindow"
  xmlns:filelist="using:Mfr.App.Ui.ViewModels.FileList"
  xmlns:filelistconfig="using:Mfr.Models.Config"
  xmlns:views="using:Mfr.App.Ui.Views"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:filelistviews="using:Mfr.App.Ui.Views.FileList"
  xmlns:filterpaletteviews="using:Mfr.App.Ui.Views.FilterPalette"
  xmlns:filterchainviews="using:Mfr.App.Ui.Views.FilterChainPane"
  xmlns:filtereditorsviews="using:Mfr.App.Ui.Views.FilterEditors"
  xmlns:renamelistviews="using:Mfr.App.Ui.Views.RenameList"
  xmlns:input="using:Mfr.App.Ui.Input"
  xmlns:resources="using:Mfr.App.Ui.Resources"
  mc:Ignorable="d"
  d:DesignWidth="1100"
  d:DesignHeight="720"
  x:Class="Mfr.App.Ui.Views.MainWindow.MainWindow"
  x:Name="MainWindowRoot"
  x:DataType="vm:MainWindowViewModel"
  Title="{Binding WindowTitle}"
  Icon="/Assets/mfr.ico"
  Width="1100"
  Height="720"
  MinWidth="800"
  MinHeight="500"
>
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="{x:Static input:AppShortcuts.Go}" Command="{Binding GoCommand}" />
    <KeyBinding Gesture="{x:Static input:AppShortcuts.UndoLast}" Command="{Binding UndoLastCommand}" />
    <KeyBinding Gesture="{x:Static input:AppShortcuts.ShowLog}" Command="{Binding ShowLogCommand}" />
    <KeyBinding Gesture="{x:Static input:AppShortcuts.ShowOptions}" Command="{Binding ShowOptionsCommand}" />
    <KeyBinding Gesture="{x:Static input:AppShortcuts.Refresh}" Command="{Binding RefreshFocusedPaneCommand}" />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.GoToAddress}"
      Command="{Binding FileListViewModel.BeginPathEditCommand}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.GoToAddressAlt}"
      Command="{Binding FileListViewModel.BeginPathEditCommand}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ViewLargeIcons}"
      Command="{Binding FileListViewModel.SetViewModeCommand}"
      CommandParameter="{x:Static filelistconfig:FileListViewMode.LargeIcons}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ViewSmallIcons}"
      Command="{Binding FileListViewModel.SetViewModeCommand}"
      CommandParameter="{x:Static filelistconfig:FileListViewMode.SmallIcons}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ViewReport}"
      Command="{Binding FileListViewModel.SetViewModeCommand}"
      CommandParameter="{x:Static filelistconfig:FileListViewMode.Report}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ViewList}"
      Command="{Binding FileListViewModel.SetViewModeCommand}"
      CommandParameter="{x:Static filelistconfig:FileListViewMode.List}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ViewTiles}"
      Command="{Binding FileListViewModel.SetViewModeCommand}"
      CommandParameter="{x:Static filelistconfig:FileListViewMode.Tiles}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ViewThumbnails}"
      Command="{Binding FileListViewModel.SetViewModeCommand}"
      CommandParameter="{x:Static filelistconfig:FileListViewMode.Thumbnails}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.AddSelected}"
      Command="{Binding RenameListViewModel.AddSelectedCommand}"
    />
    <KeyBinding Gesture="{x:Static input:AppShortcuts.AddAll}" Command="{Binding RenameListViewModel.AddAllCommand}" />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.RemoveSelected}"
      Command="{Binding RenameListViewModel.RemoveSelectedCommand}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.RemoveAllButSelected}"
      Command="{Binding RenameListViewModel.RemoveAllButSelectedCommand}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ClearRenameList}"
      Command="{Binding RenameListViewModel.ClearCommand}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ToggleBefore}"
      Command="{Binding RenameListViewModel.SetAbSideCommand}"
      CommandParameter="{x:Static filelistconfig:RenameListPrefs.AbSideOriginal}"
    />
    <KeyBinding
      Gesture="{x:Static input:AppShortcuts.ToggleAfter}"
      Command="{Binding RenameListViewModel.SetAbSideCommand}"
      CommandParameter="{x:Static filelistconfig:RenameListPrefs.AbSidePreview}"
    />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_MFR">
        <MenuItem Header="_GO" Command="{Binding GoCommand}" InputGesture="{x:Static input:AppShortcuts.Go}">
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/Go.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="_Undo last"
          Command="{Binding UndoLastCommand}"
          InputGesture="{x:Static input:AppShortcuts.UndoLast}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/Undo.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Rename _Log"
          Command="{Binding ShowLogCommand}"
          InputGesture="{x:Static input:AppShortcuts.ShowLog}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/Log.png" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="{x:Static input:AppShortcuts.Exit}" />
      </MenuItem>
      <MenuItem Header="_File List">
        <MenuItem Header="_File List type">
          <MenuItem
            Header="Large _icons"
            Command="{Binding FileListViewModel.SetViewModeCommand}"
            CommandParameter="{x:Static filelistconfig:FileListViewMode.LargeIcons}"
            InputGesture="{x:Static input:AppShortcuts.ViewLargeIcons}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsLargeIconsView, Mode=OneWay}"
          />
          <MenuItem
            Header="_Small icons"
            Command="{Binding FileListViewModel.SetViewModeCommand}"
            CommandParameter="{x:Static filelistconfig:FileListViewMode.SmallIcons}"
            InputGesture="{x:Static input:AppShortcuts.ViewSmallIcons}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsSmallIconsView, Mode=OneWay}"
          />
          <MenuItem
            Header="_Report"
            Command="{Binding FileListViewModel.SetViewModeCommand}"
            CommandParameter="{x:Static filelistconfig:FileListViewMode.Report}"
            InputGesture="{x:Static input:AppShortcuts.ViewReport}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsReportView, Mode=OneWay}"
          />
          <MenuItem
            Header="_List"
            Command="{Binding FileListViewModel.SetViewModeCommand}"
            CommandParameter="{x:Static filelistconfig:FileListViewMode.List}"
            InputGesture="{x:Static input:AppShortcuts.ViewList}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsListView, Mode=OneWay}"
          />
          <MenuItem
            Header="_Tiles"
            Command="{Binding FileListViewModel.SetViewModeCommand}"
            CommandParameter="{x:Static filelistconfig:FileListViewMode.Tiles}"
            InputGesture="{x:Static input:AppShortcuts.ViewTiles}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsTilesView, Mode=OneWay}"
          />
          <MenuItem
            Header="Thumb_nails"
            Command="{Binding FileListViewModel.SetViewModeCommand}"
            CommandParameter="{x:Static filelistconfig:FileListViewMode.Thumbnails}"
            InputGesture="{x:Static input:AppShortcuts.ViewThumbnails}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsThumbnailsView, Mode=OneWay}"
          />
        </MenuItem>
        <MenuItem Header="Thumbnail _size" IsEnabled="{Binding FileListViewModel.IsThumbnailsView}">
          <MenuItem
            Header="_Extra small"
            Command="{Binding FileListViewModel.SetThumbnailSizeCommand}"
            CommandParameter="{x:Static filelist:ThumbnailSizes.ExtraSmall}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsThumbnailSizeExtraSmall, Mode=OneWay}"
          />
          <MenuItem
            Header="_Small"
            Command="{Binding FileListViewModel.SetThumbnailSizeCommand}"
            CommandParameter="{x:Static filelist:ThumbnailSizes.Small}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsThumbnailSizeSmall, Mode=OneWay}"
          />
          <MenuItem
            Header="_Medium"
            Command="{Binding FileListViewModel.SetThumbnailSizeCommand}"
            CommandParameter="{x:Static filelist:ThumbnailSizes.Medium}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsThumbnailSizeMedium, Mode=OneWay}"
          />
          <MenuItem
            Header="_Large"
            Command="{Binding FileListViewModel.SetThumbnailSizeCommand}"
            CommandParameter="{x:Static filelist:ThumbnailSizes.Large}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsThumbnailSizeLarge, Mode=OneWay}"
          />
          <MenuItem
            Header="E_xtra large"
            Command="{Binding FileListViewModel.SetThumbnailSizeCommand}"
            CommandParameter="{x:Static filelist:ThumbnailSizes.ExtraLarge}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsThumbnailSizeExtraLarge, Mode=OneWay}"
          />
          <MenuItem
            Header="_Huge"
            Command="{Binding FileListViewModel.SetThumbnailSizeCommand}"
            CommandParameter="{x:Static filelist:ThumbnailSizes.Huge}"
            ToggleType="Radio"
            IsChecked="{Binding FileListViewModel.IsThumbnailSizeHuge, Mode=OneWay}"
          />
        </MenuItem>
        <MenuItem
          Header="Zoom _in"
          Command="{Binding FileListViewModel.ZoomThumbnailsInCommand}"
          InputGesture="{x:Static input:AppShortcuts.ZoomIn}"
        />
        <MenuItem
          Header="Zoom _out"
          Command="{Binding FileListViewModel.ZoomThumbnailsOutCommand}"
          InputGesture="{x:Static input:AppShortcuts.ZoomOut}"
        />
        <MenuItem
          Header="_Reset size"
          Command="{Binding FileListViewModel.ResetThumbnailSizeCommand}"
          InputGesture="{x:Static input:AppShortcuts.ResetZoom}"
        />
        <MenuItem
          Header="Go to _folder"
          Command="{Binding FileListViewModel.BeginPathEditCommand}"
          InputGesture="{x:Static input:AppShortcuts.GoToAddress}"
        />
        <MenuItem Header="Go _up" Command="{Binding FileListViewModel.GoUpCommand}" />
        <MenuItem
          Header="_Refresh"
          Command="{Binding FileListViewModel.RefreshCommand}"
          InputGesture="{x:Static input:AppShortcuts.Refresh}"
        />
        <Separator />
        <MenuItem Header="Show hidden/system files" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Rename List">
        <MenuItem
          Header="Add selected"
          Command="{Binding RenameListViewModel.AddSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.AddSelected}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/AddSelected.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Add all"
          Command="{Binding RenameListViewModel.AddAllCommand}"
          InputGesture="{x:Static input:AppShortcuts.AddAll}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/AddAll.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Remove"
          Command="{Binding RenameListViewModel.RemoveSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.RemoveSelected}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/RemoveSelected.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Remove all but selected"
          Command="{Binding RenameListViewModel.RemoveAllButSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.RemoveAllButSelected}"
        />
        <MenuItem
          Header="Clear"
          Command="{Binding RenameListViewModel.ClearCommand}"
          InputGesture="{x:Static input:AppShortcuts.ClearRenameList}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/Clear.png" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem
          Header="Move selected up"
          Command="{Binding RenameListViewModel.MoveSelectedUpCommand}"
          InputGesture="{x:Static input:AppShortcuts.MoveSelectedUp}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/MoveUp.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Move selected down"
          Command="{Binding RenameListViewModel.MoveSelectedDownCommand}"
          InputGesture="{x:Static input:AppShortcuts.MoveSelectedDown}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/MoveDown.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Locate in File List"
          Command="{Binding RenameListViewModel.LocateInFileListCommand}"
          InputGesture="{x:Static input:AppShortcuts.LocateInFileList}"
        />
        <MenuItem
          Header="Refresh"
          Command="{Binding RenameListViewModel.RefreshCommand}"
          InputGesture="{x:Static input:AppShortcuts.Refresh}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/Refresh.png" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem
          Header="Select fields..."
          Command="{Binding RenameListViewModel.OpenFieldShuttleCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.SelectRenameListFields}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/SelectFields.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Add columns from filters"
          Command="{Binding RenameListViewModel.AddRelevantColumnsCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.AddColumnsFromFilters}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/AddFieldsByFilters.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Set columns from filters"
          Command="{Binding RenameListViewModel.ReplaceWithRelevantColumnsCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.SetColumnsFromFilters}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/ReplaceFieldsByFilters.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Select sort fields..."
          Command="{Binding RenameListViewModel.OpenEditSortFieldsCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.EditRenameListSortFields}"
        />
        <MenuItem
          Header="Export Rename List (csv)..."
          Command="{Binding RenameListViewModel.ExportVisibleColumnsCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.ExportVisibleColumns}"
        />
        <Separator />
        <MenuItem
          Header="Use fixed-width font"
          Command="{Binding RenameListViewModel.ToggleUseFixedWidthFontCommand}"
          ToggleType="CheckBox"
          IsChecked="{Binding RenameListViewModel.UseFixedWidthFont, Mode=OneWay}"
        />
        <MenuItem
          Header="Auto-Sort"
          Command="{Binding RenameListViewModel.ToggleAutoSortCommand}"
          ToggleType="CheckBox"
          IsChecked="{Binding RenameListViewModel.IsAutoSort, Mode=OneWay}"
          ToolTip.Tip="{Binding RenameListViewModel.SortSummaryText}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/AutoSort.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Auto-Preview"
          Command="{Binding RenameListViewModel.ToggleAutoPreviewCommand}"
          ToggleType="CheckBox"
          IsChecked="{Binding RenameListViewModel.IsAutoPreview, Mode=OneWay}"
          ToolTip.Tip="{x:Static resources:AppTips.AutoPreview}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/AutoPreview.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Before/after mode"
          Command="{Binding RenameListViewModel.ToggleAbModeCommand}"
          ToggleType="CheckBox"
          IsChecked="{Binding RenameListViewModel.IsAbModeEnabled, Mode=OneWay}"
          ToolTip.Tip="{x:Static resources:AppTips.BeforeAfterMode}"
        >
          <MenuItem.Icon>
            <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
              <TextBlock Text="◀" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Toggle _before"
          Command="{Binding RenameListViewModel.SetAbSideCommand}"
          CommandParameter="{x:Static filelistconfig:RenameListPrefs.AbSideOriginal}"
          ToggleType="Radio"
          IsChecked="{Binding RenameListViewModel.IsAbSideOriginal, Mode=OneWay}"
          IsVisible="{Binding RenameListViewModel.IsAbModeEnabled}"
          InputGesture="{x:Static input:AppShortcuts.ToggleBefore}"
          ToolTip.Tip="{x:Static resources:AppTips.ToggleBefore}"
        >
          <MenuItem.Icon>
            <TextBlock Text="◀" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Toggle _after"
          Command="{Binding RenameListViewModel.SetAbSideCommand}"
          CommandParameter="{x:Static filelistconfig:RenameListPrefs.AbSidePreview}"
          ToggleType="Radio"
          IsChecked="{Binding RenameListViewModel.IsAbSidePreview, Mode=OneWay}"
          IsVisible="{Binding RenameListViewModel.IsAbModeEnabled}"
          InputGesture="{x:Static input:AppShortcuts.ToggleAfter}"
          ToolTip.Tip="{x:Static resources:AppTips.ToggleAfter}"
        >
          <MenuItem.Icon>
            <TextBlock Text="▶" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Color _legend"
          Command="{Binding RenameListViewModel.ToggleLegendCommand}"
          ToggleType="CheckBox"
          IsChecked="{Binding RenameListViewModel.IsLegendVisible, Mode=OneWay}"
          ToolTip.Tip="{x:Static resources:AppTips.ColorLegend}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/Legend.png" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="F_ilters">
        <MenuItem Header="Add selected filter" Command="{Binding AddSelectedFilterFromPaletteCommand}">
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/AddSelected.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Remove selected filter"
          Command="{Binding FilterChainViewModel.RemoveSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.RemoveSelectedFilterDelete}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/RemoveSelected.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Remove all filters" Command="{Binding FilterChainViewModel.ClearCommand}">
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/Clear.png" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem
          Header="Move filter up"
          Command="{Binding FilterChainViewModel.MoveSelectedUpCommand}"
          InputGesture="{x:Static input:AppShortcuts.MoveFilterUp}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/MoveUp.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Move filter down"
          Command="{Binding FilterChainViewModel.MoveSelectedDownCommand}"
          InputGesture="{x:Static input:AppShortcuts.MoveFilterDown}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/RenameList/MoveDown.png" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Presets" Click="_OnPresetsMenuClick" ToolTip.Tip="{x:Static resources:AppTips.Presets}">
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/FilterChain/Presets.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Save preset"
          Click="_OnSavePresetMenuClick"
          ToolTip.Tip="{x:Static resources:AppTips.SavePreset}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/FilterChain/SavePreset.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Filter options"
          Click="_OnFilterOptionsMenuClick"
          IsEnabled="{Binding FilterChainViewModel.CanShowFilterOptions}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/FilterChain/FilterOptions.png" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem
          Header="_Options"
          Command="{Binding ShowOptionsCommand}"
          InputGesture="{x:Static input:AppShortcuts.ShowOptions}"
        >
          <MenuItem.Icon>
            <Image Width="16" Height="16" Stretch="Uniform" Source="/Assets/Options.png" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem
          Header="Reset _configuration"
          Command="{Binding ResetConfigurationCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.ResetConfiguration}"
        />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About" IsEnabled="False" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Classes="pane-action-strip">
      <Border.Styles>
        <!-- Room around opaque toolbar glyphs (e.g. Options) so hover chrome is visible. -->
        <Style Selector="Button.tool-action">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
          <Setter Property="MinWidth" Value="32" />
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Padding" Value="4" />
        </Style>
      </Border.Styles>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="tool-action" Command="{Binding GoCommand}" ToolTip.Tip="{x:Static resources:AppTips.Go}">
          <Image Width="20" Height="20" Stretch="Uniform" Source="/Assets/Go.png" />
        </Button>
        <Button
          Classes="tool-action"
          Command="{Binding UndoLastCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.UndoLast}"
        >
          <Image Width="20" Height="20" Stretch="Uniform" Source="/Assets/Undo.png" />
        </Button>
        <Button
          Classes="tool-action"
          Command="{Binding ShowLogCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.ShowLog}"
        >
          <Image Width="20" Height="20" Stretch="Uniform" Source="/Assets/Log.png" />
        </Button>
        <Button
          Classes="tool-action"
          Command="{Binding ShowOptionsCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.ShowOptions}"
        >
          <Image Width="20" Height="20" Stretch="Uniform" Source="/Assets/Options.png" />
        </Button>
      </StackPanel>
    </Border>

    <Border
      DockPanel.Dock="Bottom"
      Padding="8,4"
      BorderThickness="0,1,0,0"
      BorderBrush="{DynamicResource ThemeControlMidBrush}"
    >
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <views:StyledTextView Grid.Column="0" VerticalAlignment="Center" Display="{Binding StatusHint}" />
        <TextBlock
          Grid.Column="1"
          Margin="16,0,0,0"
          VerticalAlignment="Center"
          Text="{Binding ItemCount, StringFormat='Items: {0}'}"
        />
        <TextBlock
          Grid.Column="2"
          Margin="16,0,0,0"
          VerticalAlignment="Center"
          Text="{Binding FilterCount, StringFormat='Filters: {0}'}"
        />
        <TextBlock
          Grid.Column="3"
          Margin="16,0,0,0"
          VerticalAlignment="Center"
          Text="{Binding ChangeCount, StringFormat='Changes: {0}'}"
        />
        <TextBlock
          Grid.Column="4"
          Margin="16,0,0,0"
          VerticalAlignment="Center"
          Classes="status-bar-preview-errors"
          Classes.has-errors="{Binding HasPreviewErrors}"
          Text="{Binding PreviewErrorCount, StringFormat='Preview errors: {0}'}"
        />
      </Grid>
    </Border>

    <Grid x:Name="MainPanesGrid" Background="{DynamicResource PaneChromeBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="0.61*" MinHeight="140" />
        <RowDefinition Height="6" />
        <RowDefinition Height="0.39*" MinHeight="120" />
      </Grid.RowDefinitions>
      <Grid x:Name="TopPanesGrid" Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.4*" MinWidth="180" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="0.6*" MinWidth="280" />
        </Grid.ColumnDefinitions>
        <filelistviews:FileListView
          Grid.Column="0"
          DataContext="{Binding FileListViewModel}"
          AddSelectedCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RenameListViewModel.AddSelectedCommand}"
          AddAllCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RenameListViewModel.AddAllCommand}"
          RemoveSelectedFromRenameListCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).RenameListViewModel.RemoveSelectedCommand}"
        />
        <controls:PaneSplitter
          x:Name="FileListSplitter"
          Grid.Column="1"
          ResizeDirection="Columns"
          ResizeBehavior="PreviousAndNext"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
        />
        <Grid x:Name="FilterPanesGrid" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="0.3*" MinHeight="80" />
            <RowDefinition Height="6" />
            <RowDefinition Height="0.7*" MinHeight="80" />
          </Grid.RowDefinitions>
          <Grid x:Name="FilterListsGrid" Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="0.42*" MinWidth="120" />
              <ColumnDefinition Width="6" />
              <ColumnDefinition Width="0.58*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <filterpaletteviews:FilterPaletteView
              Grid.Column="0"
              DataContext="{Binding FilterPaletteViewModel}"
              AddSelectedToFilterChainCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).AddSelectedFilterFromPaletteCommand}"
              RemoveFilterChainStepsCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).FilterChainViewModel.RemoveStepsAtIndicesCommand}"
            />
            <controls:PaneSplitter
              x:Name="AvailableAppliedSplitter"
              Grid.Column="1"
              ResizeDirection="Columns"
              ResizeBehavior="PreviousAndNext"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
            />
            <filterchainviews:FilterChainView
              x:Name="FilterChainPane"
              Grid.Column="2"
              DataContext="{Binding FilterChainViewModel}"
              AddFromPaletteCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).AddSelectedFilterFromPaletteCommand}"
            />
          </Grid>
          <controls:PaneSplitter
            x:Name="FilterEditorSplitter"
            Grid.Row="1"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
          />
          <filtereditorsviews:FilterEditorView
            Grid.Row="2"
            DataContext="{Binding FilterEditorViewModel}"
            ResetSelectedToDefaultsCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).FilterChainViewModel.ResetSelectedToDefaultsCommand}"
            SaveSelectedAsDefaultCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).FilterChainViewModel.SaveSelectedAsDefaultCommand}"
            OpenSelectedFilterHelpCommand="{Binding #MainWindowRoot.((vm:MainWindowViewModel)DataContext).FilterChainViewModel.OpenSelectedFilterHelpCommand}"
          />
        </Grid>
      </Grid>
      <controls:PaneSplitter
        x:Name="RenameListSplitter"
        Grid.Row="1"
        ResizeDirection="Rows"
        ResizeBehavior="PreviousAndNext"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <renamelistviews:RenameListView Grid.Row="2" DataContext="{Binding RenameListViewModel}" />
    </Grid>
  </DockPanel>
</Window>
