<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Mfr.App.Ui.Views.ConfirmMessageDialog"
  Icon="/Assets/mfr.ico"
  Width="420"
  MinWidth="360"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="False"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <DockPanel Margin="12">
    <StackPanel
      x:Name="Footer"
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="8"
      Margin="0,14,0,0"
    >
      <Button x:Name="OkButton" Classes="message-dialog-footer" Content="OK" IsDefault="True" Click="_OnOkClick" />
      <Button
        x:Name="CancelButton"
        Classes="message-dialog-footer"
        Content="Cancel"
        IsCancel="True"
        Click="_OnCancelClick"
      />
    </StackPanel>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
  </DockPanel>
</Window>
