<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.ConfirmMessageDialog"
  Icon="/Assets/mfr.ico"
  Width="420"
  MinWidth="360"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="False"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <DockPanel Margin="12">
    <controls:ModalOkCancelFooter x:Name="Footer" DockPanel.Dock="Bottom" Margin="0,14,0,0" />
    <StackPanel>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
      <controls:CompactCheckBox
        x:Name="KeepShowingCheckBox"
        Margin="0,12,0,0"
        IsVisible="False"
        IsChecked="True"
        Content="Keep showing this confirmation in the future"
      />
    </StackPanel>
  </DockPanel>
</Window>
