<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Mfr.App.Ui.Views.ConfirmMessageDialog"
  Icon="/Assets/mfr.ico"
  Width="420"
  MinWidth="360"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="False"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <Window.Styles>
    <Style Selector="Button.confirm-message-footer">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.confirm-message-footer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeHoverBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <StackPanel
      x:Name="Footer"
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="8"
      Margin="0,14,0,0"
    >
      <Button x:Name="OkButton" Classes="confirm-message-footer" Content="OK" IsDefault="True" Click="_OnOkClick" />
      <Button
        x:Name="CancelButton"
        Classes="confirm-message-footer"
        Content="Cancel"
        IsCancel="True"
        Click="_OnCancelClick"
      />
    </StackPanel>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
  </DockPanel>
</Window>
