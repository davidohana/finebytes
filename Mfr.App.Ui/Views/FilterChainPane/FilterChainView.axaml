<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterChainPane"
  xmlns:input="using:Mfr.App.Ui.Input"
  xmlns:resources="using:Mfr.App.Ui.Resources"
  mc:Ignorable="d"
  d:DesignWidth="280"
  d:DesignHeight="200"
  x:Class="Mfr.App.Ui.Views.FilterChainPane.FilterChainView"
  x:Name="FilterChainRoot"
  x:DataType="vm:FilterChainViewModel"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ContextMenu x:Key="FilterChainContextMenu" x:Shared="False">
        <MenuItem Header="Check all filters" Command="{Binding CheckAllFiltersCommand}" />
        <MenuItem Header="Uncheck all filters" Command="{Binding UncheckAllFiltersCommand}" />
        <MenuItem Header="Invert check" Command="{Binding InvertCheckCommand}" />
        <Separator />
        <MenuItem
          Header="Remove selected filter"
          Command="{Binding RemoveSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.RemoveSelectedFilterDelete}"
        />
        <MenuItem Header="Remove all but selected" Command="{Binding RemoveAllButSelectedCommand}" />
        <MenuItem Header="Remove all filters" Command="{Binding ClearCommand}" />
        <Separator />
        <MenuItem Header="Filter options" Click="_OnFilterOptionsClick" IsEnabled="{Binding CanShowFilterOptions}" />
      </ContextMenu>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.filter-chain-toolbar">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
    </Style>
    <Style Selector="Button.filter-chain-toolbar:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- Flush split after Presets (MFR7 16×24 dropdown abutting the Presets button). -->
    <Style Selector="Button.filter-chain-toolbar-split">
      <Setter Property="Width" Value="16" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="MaxWidth" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="-1,0,4,0" />
    </Style>
    <Style Selector="Button.filter-chain-toolbar-split:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.filter-chain">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="ListBox.filter-chain ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.filter-chain ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.filter-chain ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeHoverBrush}" />
    </Style>
    <Style Selector="ListBox.filter-chain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSelectionBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.filter-chain ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSelectionBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.filter-chain-subtitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeMutedForegroundBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="CheckBox.filter-chain-enabled">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="pane">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
      <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Classes="pane-action-rail">
        <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Top">
          <Button
            x:Name="AddFromPaletteButton"
            Classes="tool-action"
            ToolTip.Tip="{x:Static resources:AppTips.AddSelectedFilter}"
            Command="{Binding AddFromPaletteCommand, ElementName=FilterChainRoot}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/AddSelected.png" />
          </Button>
          <Button
            x:Name="RemoveFromFilterChainButton"
            Classes="tool-action"
            ToolTip.Tip="{x:Static resources:AppTips.RemoveSelectedFilter}"
            Command="{Binding RemoveSelectedCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/RemoveSelected.png" />
          </Button>
          <Button
            x:Name="ClearFilterChainButton"
            Classes="tool-action"
            ToolTip.Tip="{x:Static resources:AppTips.RemoveAllFilters}"
            Command="{Binding ClearCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/Clear.png" />
          </Button>
          <Button
            x:Name="MoveFilterChainUpButton"
            Classes="tool-action"
            ToolTip.Tip="{x:Static resources:AppTips.MoveFilterUp}"
            Command="{Binding MoveSelectedUpCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveUp.png" />
          </Button>
          <Button
            x:Name="MoveFilterChainDownButton"
            Classes="tool-action"
            ToolTip.Tip="{x:Static resources:AppTips.MoveFilterDown}"
            Command="{Binding MoveSelectedDownCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveDown.png" />
          </Button>
          <Button
            x:Name="FilterOptionsButton"
            Classes="tool-action"
            ToolTip.Tip="{x:Static resources:AppTips.FilterOptions}"
            IsEnabled="{Binding CanShowFilterOptions}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/FilterChain/FilterOptions.png" />
          </Button>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,4,0,6">
        <Button
          Grid.Column="0"
          x:Name="PresetsButton"
          Classes="tool-chrome filter-chain-toolbar"
          Margin="0"
          ToolTip.Tip="{x:Static resources:AppTips.Presets}"
        >
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image
              Width="16"
              Height="16"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Source="/Assets/FilterChain/Presets.png"
            />
            <TextBlock Text="Presets" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button
          Grid.Column="1"
          x:Name="PresetsQuickPickButton"
          Classes="tool-chrome filter-chain-toolbar filter-chain-toolbar-split"
          ToolTip.Tip="{x:Static resources:AppTips.PresetsQuickPick}"
        >
          <Path
            Width="7"
            Height="4"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{DynamicResource AppChromeForegroundBrush}"
            Data="M 0,0 L 7,0 L 3.5,4 Z"
          />
        </Button>
        <Button
          Grid.Column="2"
          x:Name="SavePresetButton"
          Classes="tool-chrome filter-chain-toolbar"
          ToolTip.Tip="{x:Static resources:AppTips.SavePreset}"
        >
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image
              Width="16"
              Height="16"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Source="/Assets/FilterChain/SavePreset.png"
            />
            <TextBlock Text="Save preset" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <ListBox
        Grid.Column="1"
        Grid.Row="1"
        x:Name="FilterChainList"
        Classes="filter-chain"
        ItemsSource="{Binding Steps}"
        SelectionMode="Multiple"
        ContextMenu="{StaticResource FilterChainContextMenu}"
      >
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FilterChainStepViewModel">
            <Grid ColumnDefinitions="Auto,*">
              <CheckBox Grid.Column="0" Classes="filter-chain-enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="filter-chain-subtitle" Text="{Binding Subtitle}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
