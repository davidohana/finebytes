<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.Controls.FormatEditor"
  xmlns:filters="using:Mfr.Filters.Formatting.FormatString"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="120"
  x:Class="Mfr.App.Ui.Views.Controls.FormatEditor.FormatEditor"
  x:Name="Root"
>
  <DockPanel x:Name="ChromeRoot" x:DataType="vm:FormatEditorViewModel" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
      <Button
        x:Name="ErrorButton"
        Classes="format-editor-error-link"
        HorizontalAlignment="Left"
        IsVisible="{Binding HasError}"
        Content="{Binding ErrorMessage}"
        Command="{Binding JumpToErrorCommand}"
        ToolTip.Tip="{Binding FullErrorMessage}"
      />
    </StackPanel>

    <StackPanel DockPanel.Dock="Right" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Top">
      <Button
        x:Name="InsertButton"
        Classes="filter-editor-button"
        Content="▶"
        ToolTip.Tip="Insert formatting parameter"
        Width="28"
        Padding="0"
      >
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <Border Width="280" MaxHeight="320" Padding="6">
              <DockPanel>
                <TextBox
                  x:Name="InsertSearchBox"
                  DockPanel.Dock="Top"
                  Classes="filter-editor-field"
                  Watermark="Search tokens…"
                  Margin="0,0,0,6"
                  Text="{Binding SearchText}"
                />
                <ListBox x:Name="InsertList" ItemsSource="{Binding VisibleEntries}" MaxHeight="280">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="filters:FormatTokenCatalogEntry">
                      <StackPanel Spacing="0" ToolTip.Tip="{Binding ShortDescription}">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                          Text="{Binding GroupPath}"
                          Opacity="0.7"
                          FontSize="11"
                          TextTrimming="CharacterEllipsis"
                        />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="6,4" />
                    </Style>
                  </ListBox.Styles>
                </ListBox>
              </DockPanel>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button
        x:Name="EditButton"
        Classes="filter-editor-button"
        Content="Edit"
        ToolTip.Tip="Edit formatting parameter under caret"
        Command="{Binding EditCommand}"
      />
    </StackPanel>

    <TextBox
      x:Name="TemplateBox"
      Classes="filter-editor-field-wrap"
      MinHeight="64"
      AcceptsReturn="True"
      TextWrapping="Wrap"
      Watermark="{Binding Watermark, ElementName=Root}"
      TextChanged="_OnTemplateTextChanged"
    />
  </DockPanel>
</UserControl>
