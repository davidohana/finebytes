<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.Controls.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.Controls.FormatEditor.TokenEditors.CounterFormatTokenEditorView"
  x:DataType="vm:CounterFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Initial:">
      <controls:CompactNumericUpDown
        Width="80"
        HorizontalAlignment="Left"
        Minimum="-999999"
        Maximum="999999"
        Increment="1"
        FormatString="0"
        Value="{Binding Initial}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Step:">
      <controls:CompactNumericUpDown
        Width="80"
        HorizontalAlignment="Left"
        Minimum="-99999"
        Maximum="99999"
        Increment="1"
        FormatString="0"
        Value="{Binding Step}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Padding:">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox
          Classes="filter-editor-field"
          Width="110"
          ItemsSource="{x:Static vm:CounterFormatTokenEditorViewModel.PaddingChoices}"
          SelectedItem="{Binding Padding}"
        />
        <TextBlock
          Classes="filter-editor-label"
          VerticalAlignment="Center"
          Text="Length:"
          IsVisible="{Binding IsLengthEnabled}"
        />
        <controls:CompactNumericUpDown
          Width="56"
          HorizontalAlignment="Left"
          Minimum="1"
          Maximum="100"
          Increment="1"
          FormatString="0"
          IsVisible="{Binding IsLengthEnabled}"
          Value="{Binding Length}"
        />
      </StackPanel>
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Reset scope:">
      <ComboBox
        Classes="filter-editor-field"
        Width="120"
        HorizontalAlignment="Left"
        ItemsSource="{x:Static vm:CounterFormatTokenEditorViewModel.ResetScopeChoices}"
        SelectedItem="{Binding ResetScope}"
      />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
