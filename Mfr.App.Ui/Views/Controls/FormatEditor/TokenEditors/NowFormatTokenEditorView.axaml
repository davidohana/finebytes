<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.Controls.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.Controls.FormatEditor.TokenEditors.NowFormatTokenEditorView"
  x:DataType="vm:NowFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Format:">
      <TextBox
        Classes="filter-editor-field"
        MinWidth="240"
        HorizontalAlignment="Stretch"
        Watermark="(ISO-8601 when empty)"
        Text="{Binding Format}"
      />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
