<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.Controls.FormatEditor.TokenEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.Controls.FormatEditor.TokenEditors.ExifFormatTokenEditorView"
  x:DataType="vm:ExifFormatTokenEditorViewModel"
>
  <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
    <controls:FilterEditorLabeledRow Label="Source:">
      <ComboBox
        Classes="filter-editor-field"
        MinWidth="140"
        HorizontalAlignment="Left"
        ItemsSource="{Binding SourceAliases}"
        SelectedItem="{Binding Source}"
      />
    </controls:FilterEditorLabeledRow>
    <controls:FilterEditorLabeledRow Label="Name / id:">
      <TextBox Classes="filter-editor-field" MinWidth="200" HorizontalAlignment="Stretch" Text="{Binding Name}" />
    </controls:FilterEditorLabeledRow>
  </StackPanel>
</UserControl>
