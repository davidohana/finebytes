<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  x:Class="Mfr.App.Ui.Views.Controls.ModalOkCancelFooter"
  HorizontalAlignment="Center"
>
  <StackPanel
    Orientation="Horizontal"
    HorizontalAlignment="Center"
    Spacing="{Binding Spacing, RelativeSource={RelativeSource AncestorType=controls:ModalOkCancelFooter}}"
  >
    <Button
      x:Name="OkButton"
      Classes="message-dialog-footer"
      Content="{Binding AcceptContent, RelativeSource={RelativeSource AncestorType=controls:ModalOkCancelFooter}}"
      IsDefault="True"
      IsEnabled="{Binding IsAcceptEnabled, RelativeSource={RelativeSource AncestorType=controls:ModalOkCancelFooter}}"
      ToolTip.Tip="{Binding AcceptDisabledTip, RelativeSource={RelativeSource AncestorType=controls:ModalOkCancelFooter}}"
      ToolTip.ShowOnDisabled="True"
      Click="_OnOkClick"
    />
    <Button
      x:Name="CancelButton"
      Classes="message-dialog-footer"
      Content="Cancel"
      IsCancel="True"
      Click="_OnCancelClick"
    />
  </StackPanel>
</UserControl>
