<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.AppliedFilters"
  xmlns:input="using:Mfr.App.Ui.Input"
  xmlns:resources="using:Mfr.App.Ui.Resources"
  mc:Ignorable="d"
  d:DesignWidth="280"
  d:DesignHeight="200"
  x:Class="Mfr.App.Ui.Views.AppliedFilters.AppliedFiltersView"
  x:Name="AppliedFiltersRoot"
  x:DataType="vm:AppliedFiltersViewModel"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ContextMenu x:Key="AppliedFiltersContextMenu" x:Shared="False">
        <MenuItem Header="Check All Filters" Command="{Binding CheckAllFiltersCommand}" />
        <MenuItem Header="Uncheck All Filters" Command="{Binding UncheckAllFiltersCommand}" />
        <MenuItem Header="Invert Check" Command="{Binding InvertCheckCommand}" />
        <Separator />
        <MenuItem
          Header="Remove Selected Filter"
          Command="{Binding RemoveSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.RemoveSelectedFilterDelete}"
        />
        <MenuItem Header="Remove All But Selected" Command="{Binding RemoveAllButSelectedCommand}" />
        <MenuItem Header="Remove All Filters" Command="{Binding ClearCommand}" />
        <Separator />
        <MenuItem Header="Filter Options" Click="_OnFilterOptionsClick" IsEnabled="{Binding CanShowFilterOptions}" />
      </ContextMenu>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.applied-filter-toolbar">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="{DynamicResource PaneChromeBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.applied-filter-toolbar:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.applied-filter-toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Flush split after Presets (MFR7 16×24 dropdown abutting the Presets button). -->
    <Style Selector="Button.applied-filter-toolbar-split">
      <Setter Property="Width" Value="16" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="MaxWidth" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="-1,0,4,0" />
    </Style>
    <Style Selector="Button.applied-filter-toolbar-split:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail">
      <Setter Property="Background" Value="{DynamicResource AppChromeHeaderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail Button.rename-list-action">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail Button.rename-list-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail Button.rename-list-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeHoverBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeHoverBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSelectionBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppChromeSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeSelectionBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem.drop-mark">
      <Setter Property="Background" Value="{DynamicResource DropMarkBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem.drop-mark:selected">
      <Setter Property="Background" Value="{DynamicResource DropMarkBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem.drop-mark:pointerover">
      <Setter Property="Background" Value="{DynamicResource DropMarkBrush}" />
    </Style>
    <Style Selector="TextBlock.applied-filter-apply-to">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeMutedForegroundBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="CheckBox.applied-filter-enabled">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="pane">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
      <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Classes="applied-filter-shuttle-rail">
        <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Top">
          <Button
            x:Name="AddFromPaletteButton"
            Classes="rename-list-action"
            ToolTip.Tip="{x:Static resources:AppTips.AddSelectedFilter}"
            Command="{Binding AddFromPaletteCommand, ElementName=AppliedFiltersRoot}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/AddSelected.png" />
          </Button>
          <Button
            x:Name="RemoveFromAppliedButton"
            Classes="rename-list-action"
            ToolTip.Tip="{x:Static resources:AppTips.RemoveSelectedFilter}"
            Command="{Binding RemoveSelectedCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/RemoveSelected.png" />
          </Button>
          <Button
            x:Name="ClearAppliedButton"
            Classes="rename-list-action"
            ToolTip.Tip="{x:Static resources:AppTips.RemoveAllFilters}"
            Command="{Binding ClearCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/Clear.png" />
          </Button>
          <Button
            x:Name="MoveAppliedUpButton"
            Classes="rename-list-action"
            ToolTip.Tip="{x:Static resources:AppTips.MoveFilterUp}"
            Command="{Binding MoveSelectedUpCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveUp.png" />
          </Button>
          <Button
            x:Name="MoveAppliedDownButton"
            Classes="rename-list-action"
            ToolTip.Tip="{x:Static resources:AppTips.MoveFilterDown}"
            Command="{Binding MoveSelectedDownCommand}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveDown.png" />
          </Button>
          <Button
            x:Name="FilterOptionsButton"
            Classes="rename-list-action"
            ToolTip.Tip="{x:Static resources:AppTips.FilterOptions}"
            IsEnabled="{Binding CanShowFilterOptions}"
          >
            <Image Width="24" Height="24" Stretch="None" Source="/Assets/AppliedFilters/FilterOptions.png" />
          </Button>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,4,0,6">
        <Button
          Grid.Column="0"
          x:Name="PresetsButton"
          Classes="applied-filter-toolbar"
          Margin="0"
          ToolTip.Tip="{x:Static resources:AppTips.Presets}"
        >
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image
              Width="22"
              Height="16"
              VerticalAlignment="Center"
              Stretch="None"
              Source="/Assets/AppliedFilters/Presets.png"
            />
            <TextBlock Text="Presets" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button
          Grid.Column="1"
          x:Name="PresetsQuickPickButton"
          Classes="applied-filter-toolbar applied-filter-toolbar-split"
          ToolTip.Tip="{x:Static resources:AppTips.PresetsQuickPick}"
        >
          <Path
            Width="7"
            Height="4"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{DynamicResource AppChromeForegroundBrush}"
            Data="M 0,0 L 7,0 L 3.5,4 Z"
          />
        </Button>
        <Button
          Grid.Column="2"
          x:Name="SavePresetButton"
          Classes="applied-filter-toolbar"
          ToolTip.Tip="{x:Static resources:AppTips.SavePreset}"
        >
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image
              Width="22"
              Height="16"
              VerticalAlignment="Center"
              Stretch="None"
              Source="/Assets/AppliedFilters/SavePreset.png"
            />
            <TextBlock Text="Save Preset" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <ListBox
        Grid.Column="1"
        Grid.Row="1"
        x:Name="AppliedFiltersList"
        Classes="applied-filters"
        ItemsSource="{Binding Steps}"
        SelectionMode="Multiple"
        ContextMenu="{StaticResource AppliedFiltersContextMenu}"
      >
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AppliedFilterStepViewModel">
            <Grid ColumnDefinitions="Auto,*">
              <CheckBox Grid.Column="0" Classes="applied-filter-enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                  Classes="applied-filter-apply-to"
                  Text="{Binding ApplyToLabel}"
                  IsVisible="{Binding ApplyToLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
