<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.AppliedFilters"
  xmlns:resources="using:Mfr.App.Ui.Resources"
  mc:Ignorable="d"
  d:DesignWidth="280"
  d:DesignHeight="200"
  x:Class="Mfr.App.Ui.Views.AppliedFilters.AppliedFiltersView"
  x:Name="AppliedFiltersRoot"
  x:DataType="vm:AppliedFiltersViewModel"
>
  <UserControl.Styles>
    <Style Selector="Button.applied-filter-toolbar">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="Background" Value="{DynamicResource PaneChromeBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.applied-filter-toolbar:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail">
      <Setter Property="Background" Value="{DynamicResource FileListHeaderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail Button.rename-list-action">
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail Button.rename-list-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
    </Style>
    <Style Selector="Border.applied-filter-shuttle-rail Button.rename-list-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters">
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem.drop-mark">
      <Setter Property="Background" Value="{DynamicResource RenameListDropIndicatorBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem.drop-mark:selected">
      <Setter Property="Background" Value="{DynamicResource RenameListDropIndicatorBrush}" />
    </Style>
    <Style Selector="ListBox.applied-filters ListBoxItem.drop-mark:pointerover">
      <Setter Property="Background" Value="{DynamicResource RenameListDropIndicatorBrush}" />
    </Style>
    <Style Selector="TextBlock.applied-filter-apply-to">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FileListBreadcrumbMutedBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="CheckBox.applied-filter-enabled">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="pane">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,1">
        <Button Grid.Column="0" Classes="applied-filter-toolbar" Content="Presets" IsEnabled="False" />
        <Button Grid.Column="1" Classes="applied-filter-toolbar" Content="Save Preset" IsEnabled="False" />
        <Button
          Grid.Column="3"
          x:Name="FilterOptionsButton"
          Classes="applied-filter-toolbar"
          Content="Filter Options"
          ToolTip.Tip="{x:Static resources:AppTips.FilterOptions}"
          IsEnabled="{Binding CanShowFilterOptions}"
        />
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="applied-filter-shuttle-rail">
          <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Top">
            <Button
              x:Name="AddFromPaletteButton"
              Classes="rename-list-action"
              ToolTip.Tip="{x:Static resources:AppTips.AddSelectedFilter}"
              Command="{Binding AddFromPaletteCommand, ElementName=AppliedFiltersRoot}"
            >
              <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/AddSelected.png" />
            </Button>
            <Button
              x:Name="RemoveFromAppliedButton"
              Classes="rename-list-action"
              ToolTip.Tip="{x:Static resources:AppTips.RemoveSelectedFilter}"
              Command="{Binding RemoveSelectedCommand}"
            >
              <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/RemoveSelected.png" />
            </Button>
            <Button
              x:Name="ClearAppliedButton"
              Classes="rename-list-action"
              ToolTip.Tip="{x:Static resources:AppTips.RemoveAllFilters}"
              Command="{Binding ClearCommand}"
            >
              <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/Clear.png" />
            </Button>
            <Button
              x:Name="MoveAppliedUpButton"
              Classes="rename-list-action"
              ToolTip.Tip="{x:Static resources:AppTips.MoveFilterUp}"
              Command="{Binding MoveSelectedUpCommand}"
            >
              <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveUp.png" />
            </Button>
            <Button
              x:Name="MoveAppliedDownButton"
              Classes="rename-list-action"
              ToolTip.Tip="{x:Static resources:AppTips.MoveFilterDown}"
              Command="{Binding MoveSelectedDownCommand}"
            >
              <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveDown.png" />
            </Button>
          </StackPanel>
        </Border>
        <ListBox
          Grid.Column="1"
          x:Name="AppliedFiltersList"
          Classes="applied-filters"
          ItemsSource="{Binding Steps}"
          SelectionMode="Multiple"
        >
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AppliedFilterStepViewModel">
              <Grid ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0" Classes="applied-filter-enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Classes="applied-filter-apply-to"
                    Text="{Binding ApplyToLabel}"
                    IsVisible="{Binding ApplyToLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
