<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.AppliedFilters"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:converters="using:Mfr.App.Ui.Converters"
  x:Class="Mfr.App.Ui.Views.AppliedFilters.FilterOptionsDialog"
  x:DataType="vm:FilterOptionsDialogViewModel"
  Title="Filter Options"
  Icon="/Assets/mfr.ico"
  Width="540"
  MinWidth="460"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  CanResize="True"
  ShowInTaskbar="False"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <Window.Styles>
    <Style Selector="TextBlock.filter-options-suffix">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.filter-options-from-the">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="ComboBox.filter-options-field, TextBox.filter-options-field">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.filter-options-field">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.filter-options-anchor">
      <Setter Property="Width" Value="80" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="ComboBox.filter-options-anchor /template/ ContentPresenter#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,0,4,0" />
    </Style>
    <Style Selector="ComboBox.filter-options-field /template/ ContentPresenter#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- StyleKey is RadioButton (CompactRadioButton override); type selector would not match. -->
    <Style Selector="RadioButton.filter-options-radio">
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <controls:ModalOkCancelFooter
      x:Name="Footer"
      DockPanel.Dock="Bottom"
      Margin="0,12,0,0"
      IsAcceptEnabled="{Binding CanConfirm}"
      AcceptDisabledTip="{Binding ConfirmDisabledReason, Converter={x:Static converters:RichToolTipConverter.Instance}}"
    />

    <!-- Outer frame matches MFR7 untitled GroupBox around form body (buttons stay outside). -->
    <Border
      Padding="10,12,10,10"
      Background="{DynamicResource AppChromeSurfaceBrush}"
      BorderBrush="{DynamicResource AppChromeBorderBrush}"
      BorderThickness="1"
    >
      <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
        <controls:FilterEditorLabeledRow Label="Name:">
          <TextBox x:Name="NameBox" Classes="filter-options-field" MaxLength="100" Text="{Binding Name}" />
        </controls:FilterEditorLabeledRow>

        <StackPanel Spacing="8" IsVisible="{Binding HasApplyTo}">
          <controls:FilterEditorLabeledRow
            Label="Apply To:"
            ToolTip.Tip="Which part of the path or metadata this filter transforms (name, extension, folder, tags, …)."
          >
            <Grid ColumnDefinitions="*,6,*">
              <ComboBox
                Classes="filter-options-field"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding TargetGroups}"
                SelectedItem="{Binding SelectedTargetGroup}"
                ToolTip.Tip="Target category (file name parts, folders, audio fields, …)."
              >
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterTargetGroupOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox
                Grid.Column="2"
                Classes="filter-options-field"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding TargetOptions}"
                SelectedItem="{Binding SelectedTargetOption}"
                ToolTip.Tip="{Binding SelectedTargetToolTip, Converter={x:Static converters:RichToolTipConverter.Instance}}"
              >
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterTargetOption">
                    <TextBlock
                      Text="{Binding Label}"
                      ToolTip.Tip="{Binding Tip, Converter={x:Static converters:RichToolTipConverter.Instance}}"
                    />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </controls:FilterEditorLabeledRow>

          <StackPanel
            x:Name="Id3v2MultiInstanceFieldsPanel"
            Spacing="8"
            IsVisible="{Binding HasId3v2MultiInstanceFields}"
          >
            <controls:FilterEditorLabeledRow
              x:Name="Id3v2LanguageRow"
              Label="Language:"
              IsVisible="{Binding HasId3v2Language}"
            >
              <ToolTip.Tip>
                <controls:RichToolTip>
                  <TextBlock Classes="rich-tip-body" Text="Optional ID3v2 language code." />
                  <TextBlock
                    Classes="rich-tip-bullet"
                    Text="• Used to pick among multiple COMM / USLT frames with the same frame ID."
                  />
                </controls:RichToolTip>
              </ToolTip.Tip>
              <TextBox Classes="filter-options-field" Text="{Binding Id3v2Language}" />
            </controls:FilterEditorLabeledRow>
            <controls:FilterEditorLabeledRow x:Name="Id3v2DescriptionRow" Label="Description:">
              <ToolTip.Tip>
                <controls:RichToolTip>
                  <TextBlock Classes="rich-tip-body" Text="Optional ID3v2 description." />
                  <TextBlock
                    Classes="rich-tip-bullet"
                    Text="• Used to pick among multiple frames with the same frame ID."
                  />
                </controls:RichToolTip>
              </ToolTip.Tip>
              <TextBox Classes="filter-options-field" Text="{Binding Id3v2Description}" />
            </controls:FilterEditorLabeledRow>
          </StackPanel>

          <controls:FilterEditorLabeledRow
            x:Name="AncestorFolderLevelRow"
            Label="Level:"
            IsVisible="{Binding HasAncestorFolderLevel}"
          >
            <ToolTip.Tip>
              <controls:RichToolTip>
                <TextBlock Classes="rich-tip-bullet" Text="• 1 is the immediate parent folder name." />
                <TextBlock Classes="rich-tip-bullet" Text="• Higher values walk toward the drive root." />
              </controls:RichToolTip>
            </ToolTip.Tip>
            <controls:CompactNumericUpDown
              x:Name="AncestorFolderLevelSpinner"
              Minimum="1"
              Maximum="99"
              FormatString="0"
              Value="{Binding AncestorFolderLevel}"
              HorizontalAlignment="Left"
            />
          </controls:FilterEditorLabeledRow>

          <controls:FilterEditorLabeledRow Label="Apply on:">
            <ToolTip.Tip>
              <controls:RichToolTip>
                <TextBlock Classes="rich-tip-title" Text="Limit where the filter runs." />
                <TextBlock Classes="rich-tip-bullet" Text="• Whole: entire Apply-to value." />
                <TextBlock Classes="rich-tip-bullet" Text="• Substring: inclusive character range." />
                <TextBlock Classes="rich-tip-bullet" Text="• Token: one piece after splitting." />
              </controls:RichToolTip>
            </ToolTip.Tip>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <controls:CompactRadioButton
                x:Name="WholeScopeRadio"
                Classes="filter-options-radio"
                GroupName="ApplyScope"
                Content="Whole"
                ToolTip.Tip="Apply the filter to the entire Apply-to value."
                IsChecked="{Binding ScopeMode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:FilterApplyScopeMode.Whole}, Mode=TwoWay}"
              />
              <controls:CompactRadioButton
                x:Name="SubstringScopeRadio"
                Classes="filter-options-radio"
                GroupName="ApplyScope"
                Content="Substring"
                ToolTip.Tip="Apply only to an inclusive character range within the value."
                IsChecked="{Binding ScopeMode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:FilterApplyScopeMode.Substring}, Mode=TwoWay}"
              />
              <controls:CompactRadioButton
                x:Name="TokenScopeRadio"
                Classes="filter-options-radio"
                GroupName="ApplyScope"
                Content="Token"
                ToolTip.Tip="Split the value by a separator and apply only to one numbered piece."
                IsChecked="{Binding ScopeMode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:FilterApplyScopeMode.Token}, Mode=TwoWay}"
              />
            </StackPanel>
          </controls:FilterEditorLabeledRow>

          <controls:FieldsetGroup Header="Substring" IsVisible="{Binding ShowSubstringOptions}">
            <Grid Grid.IsSharedSizeScope="True">
              <ToolTip.Tip>
                <controls:RichToolTip>
                  <TextBlock Classes="rich-tip-title" Text="Inclusive 1-based range." />
                  <TextBlock Classes="rich-tip-bullet" Text="• Left counts from the start." />
                  <TextBlock Classes="rich-tip-bullet" Text="• Right counts from the end." />
                </controls:RichToolTip>
              </ToolTip.Tip>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsSubstringLabel" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock
                Classes="filter-editor-label"
                VerticalAlignment="Center"
                TextAlignment="Right"
                Text="Start at position:"
              />
              <controls:CompactNumericUpDown
                x:Name="SubstringStartSpinner"
                Grid.Column="2"
                Minimum="1"
                Maximum="9999"
                FormatString="0"
                Value="{Binding SubstringStartPosition}"
              />
              <TextBlock Grid.Column="3" Classes="filter-options-from-the" Text="from the" />
              <ComboBox
                Grid.Column="4"
                Classes="filter-options-field filter-options-anchor"
                ItemsSource="{Binding ScopeAnchorOptions}"
                SelectedItem="{Binding SubstringStartAnchorOption}"
              >
                <ToolTip.Tip>
                  <controls:RichToolTip>
                    <TextBlock Classes="rich-tip-bullet" Text="• Left: position 1 is the first character." />
                    <TextBlock Classes="rich-tip-bullet" Text="• Right: position 1 is the last character." />
                  </controls:RichToolTip>
                </ToolTip.Tip>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StringScopeAnchorOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="5" Classes="filter-options-suffix" Text="side (incl.)" />

              <TextBlock
                Grid.Row="2"
                Classes="filter-editor-label"
                VerticalAlignment="Center"
                TextAlignment="Right"
                Text="End at position:"
              />
              <controls:CompactNumericUpDown
                x:Name="SubstringEndSpinner"
                Grid.Row="2"
                Grid.Column="2"
                Minimum="1"
                Maximum="9999"
                FormatString="0"
                Value="{Binding SubstringEndPosition}"
              />
              <TextBlock Grid.Row="2" Grid.Column="3" Classes="filter-options-from-the" Text="from the" />
              <ComboBox
                Grid.Row="2"
                Grid.Column="4"
                Classes="filter-options-field filter-options-anchor"
                ItemsSource="{Binding ScopeAnchorOptions}"
                SelectedItem="{Binding SubstringEndAnchorOption}"
              >
                <ToolTip.Tip>
                  <controls:RichToolTip>
                    <TextBlock Classes="rich-tip-bullet" Text="• Left: position 1 is the first character." />
                    <TextBlock Classes="rich-tip-bullet" Text="• Right: position 1 is the last character." />
                  </controls:RichToolTip>
                </ToolTip.Tip>
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StringScopeAnchorOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="2" Grid.Column="5" Classes="filter-options-suffix" Text="side (incl.)" />
            </Grid>
          </controls:FieldsetGroup>

          <controls:FieldsetGroup Header="Token" IsVisible="{Binding ShowTokenOptions}">
            <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
              <controls:FilterEditorLabeledRow
                Label="Token separator string:"
                ToolTip.Tip="Characters that split the value into tokens (e.g. - or space)."
              >
                <TextBox
                  x:Name="TokenSeparatorBox"
                  Classes="filter-options-field"
                  MaxLength="100"
                  Text="{Binding TokenSeparator}"
                />
              </controls:FilterEditorLabeledRow>
              <controls:FilterEditorLabeledRow
                Label="Token number:"
                ToolTip.Tip="1-based index of the token to transform (1 = first piece)."
              >
                <controls:CompactNumericUpDown
                  x:Name="TokenNumberSpinner"
                  Minimum="1"
                  Maximum="9999"
                  FormatString="0"
                  Value="{Binding TokenNumber}"
                  HorizontalAlignment="Left"
                />
              </controls:FilterEditorLabeledRow>
            </StackPanel>
          </controls:FieldsetGroup>
        </StackPanel>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
