<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.AppliedFilters"
  x:Class="Mfr.App.Ui.Views.AppliedFilters.FilterOptionsDialog"
  x:DataType="vm:FilterOptionsDialogViewModel"
  Title="Filter Options"
  Icon="/Assets/mfr.ico"
  Width="400"
  SizeToContent="Height"
  MinWidth="360"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
  ShowInTaskbar="False"
>
  <DockPanel Margin="12">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="12"
      Margin="0,12,0,0"
    >
      <Button
        x:Name="OkButton"
        Content="OK"
        MinWidth="80"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        IsDefault="True"
        Click="_OnOkClick"
      />
      <Button
        Content="Cancel"
        MinWidth="80"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        IsCancel="True"
        Click="_OnCancelClick"
      />
    </StackPanel>

    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Name:" />
        <TextBox Grid.Column="1" Text="{Binding Name}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasApplyTo}">
        <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Apply To:" />
        <ComboBox
          x:Name="ApplyToCombo"
          Grid.Column="1"
          MinWidth="160"
          HorizontalAlignment="Left"
          ItemsSource="{Binding ApplyToOptions}"
          SelectedItem="{Binding SelectedApplyTo}"
        >
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterTargetOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
