<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.AppliedFilters"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:converters="using:Mfr.App.Ui.Converters"
  x:Class="Mfr.App.Ui.Views.AppliedFilters.FilterOptionsDialog"
  x:DataType="vm:FilterOptionsDialogViewModel"
  Title="Filter Options"
  Icon="/Assets/mfr.ico"
  Width="540"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
  ShowInTaskbar="False"
  FontFamily="{StaticResource FileListFont}"
  FontSize="{StaticResource FileListFontSize}"
  Foreground="{DynamicResource FileListForegroundBrush}"
>
  <Window.Styles>
    <Style Selector="TextBlock.filter-options-label">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.filter-options-suffix">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.filter-options-from-the">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="ComboBox.filter-options-field, TextBox.filter-options-field">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.filter-options-field">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.filter-options-anchor">
      <Setter Property="Width" Value="80" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="ComboBox.filter-options-anchor /template/ ContentPresenter#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,0,4,0" />
    </Style>
    <Style Selector="ComboBox.filter-options-field /template/ ContentPresenter#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- StyleKey is RadioButton (CompactRadioButton override); type selector would not match. -->
    <Style Selector="RadioButton.filter-options-radio">
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style Selector="Button.filter-options-footer">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.filter-options-footer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="8"
      Margin="0,14,0,0"
    >
      <Button
        x:Name="OkButton"
        Classes="filter-options-footer"
        Content="OK"
        IsDefault="True"
        IsEnabled="{Binding CanConfirm}"
        ToolTip.Tip="{Binding ConfirmDisabledReason, Converter={x:Static converters:RichToolTipConverter.Instance}}"
        ToolTip.ShowOnDisabled="True"
        Click="_OnOkClick"
      />
      <Button Classes="filter-options-footer" Content="Cancel" IsCancel="True" Click="_OnCancelClick" />
    </StackPanel>

    <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Classes="filter-options-label" Text="Name:" />
        <TextBox Grid.Column="1" Classes="filter-options-field" Text="{Binding Name}" />
      </Grid>

      <StackPanel Spacing="8" IsVisible="{Binding HasApplyTo}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Classes="filter-options-label"
            Text="Apply to:"
            ToolTip.Tip="Which part of the path or metadata this filter transforms (name, extension, folder, tags, …)."
          />
          <ComboBox
            Grid.Column="1"
            Classes="filter-options-field"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding TargetGroups}"
            SelectedItem="{Binding SelectedTargetGroup}"
            ToolTip.Tip="Target category (file name parts, folders, audio fields, …)."
          >
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterTargetGroupOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox
            Grid.Column="3"
            Classes="filter-options-field"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding TargetOptions}"
            SelectedItem="{Binding SelectedTargetOption}"
            ToolTip.Tip="Specific field within the selected category."
          >
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterTargetOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <StackPanel
          x:Name="Id3v2MultiInstanceFieldsPanel"
          Spacing="8"
          IsVisible="{Binding HasId3v2MultiInstanceFields}"
        >
          <Grid x:Name="Id3v2LanguageGrid" IsVisible="{Binding HasId3v2Language}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="filter-options-label" Text="Language:">
              <ToolTip.Tip>
                <controls:RichToolTip>
                  <TextBlock Classes="rich-tip-body" Text="Optional ID3v2 language code." />
                  <TextBlock
                    Classes="rich-tip-bullet"
                    Text="• Used to pick among multiple COMM / USLT frames with the same frame ID."
                  />
                </controls:RichToolTip>
              </ToolTip.Tip>
            </TextBlock>
            <TextBox Grid.Column="1" Classes="filter-options-field" Text="{Binding Id3v2Language}" />
          </Grid>
          <Grid x:Name="Id3v2DescriptionGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="filter-options-label" Text="Description:">
              <ToolTip.Tip>
                <controls:RichToolTip>
                  <TextBlock Classes="rich-tip-body" Text="Optional ID3v2 description." />
                  <TextBlock
                    Classes="rich-tip-bullet"
                    Text="• Used to pick among multiple frames with the same frame ID."
                  />
                </controls:RichToolTip>
              </ToolTip.Tip>
            </TextBlock>
            <TextBox Grid.Column="1" Classes="filter-options-field" Text="{Binding Id3v2Description}" />
          </Grid>
        </StackPanel>

        <Grid x:Name="AncestorFolderLevelGrid" IsVisible="{Binding HasAncestorFolderLevel}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="filter-options-label" Text="Level:">
            <ToolTip.Tip>
              <controls:RichToolTip>
                <TextBlock Classes="rich-tip-bullet" Text="• 1 is the immediate parent folder name." />
                <TextBlock Classes="rich-tip-bullet" Text="• Higher values walk toward the drive root." />
              </controls:RichToolTip>
            </ToolTip.Tip>
          </TextBlock>
          <controls:CompactNumericUpDown
            x:Name="AncestorFolderLevelSpinner"
            Grid.Column="1"
            Minimum="1"
            Maximum="99"
            FormatString="0"
            Value="{Binding AncestorFolderLevel}"
          >
            <ToolTip.Tip>
              <controls:RichToolTip>
                <TextBlock Classes="rich-tip-bullet" Text="• 1 is the immediate parent folder name." />
                <TextBlock Classes="rich-tip-bullet" Text="• Higher values walk toward the drive root." />
              </controls:RichToolTip>
            </ToolTip.Tip>
          </controls:CompactNumericUpDown>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="filter-options-label" Text="Apply on:">
            <ToolTip.Tip>
              <controls:RichToolTip>
                <TextBlock Classes="rich-tip-title" Text="Limit where the filter runs." />
                <TextBlock Classes="rich-tip-bullet" Text="• Whole: entire Apply-to value." />
                <TextBlock Classes="rich-tip-bullet" Text="• Substring: inclusive character range." />
                <TextBlock Classes="rich-tip-bullet" Text="• Token: one piece after splitting." />
              </controls:RichToolTip>
            </ToolTip.Tip>
          </TextBlock>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <controls:CompactRadioButton
              x:Name="WholeScopeRadio"
              Classes="filter-options-radio"
              GroupName="ApplyScope"
              Content="Whole"
              ToolTip.Tip="Apply the filter to the entire Apply-to value."
              IsChecked="{Binding ScopeMode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:FilterApplyScopeMode.Whole}, Mode=TwoWay}"
            />
            <controls:CompactRadioButton
              x:Name="SubstringScopeRadio"
              Classes="filter-options-radio"
              GroupName="ApplyScope"
              Content="Substring"
              ToolTip.Tip="Apply only to an inclusive character range within the value."
              IsChecked="{Binding ScopeMode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:FilterApplyScopeMode.Substring}, Mode=TwoWay}"
            />
            <controls:CompactRadioButton
              x:Name="TokenScopeRadio"
              Classes="filter-options-radio"
              GroupName="ApplyScope"
              Content="Token"
              ToolTip.Tip="Split the value by a separator and apply only to one numbered piece."
              IsChecked="{Binding ScopeMode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:FilterApplyScopeMode.Token}, Mode=TwoWay}"
            />
          </StackPanel>
        </Grid>

        <controls:FieldsetGroup Header="Substring" IsVisible="{Binding ShowSubstringOptions}">
          <Grid>
            <ToolTip.Tip>
              <controls:RichToolTip>
                <TextBlock Classes="rich-tip-title" Text="Inclusive 1-based range." />
                <TextBlock Classes="rich-tip-bullet" Text="• Left counts from the start." />
                <TextBlock Classes="rich-tip-bullet" Text="• Right counts from the end." />
              </controls:RichToolTip>
            </ToolTip.Tip>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsGroupLabel" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Classes="filter-options-label" Text="Start at position" />
            <controls:CompactNumericUpDown
              x:Name="SubstringStartSpinner"
              Grid.Column="1"
              Minimum="1"
              Maximum="9999"
              FormatString="0"
              Value="{Binding SubstringStartPosition}"
            />
            <TextBlock Grid.Column="2" Classes="filter-options-from-the" Text="from the" />
            <ComboBox
              Grid.Column="3"
              Classes="filter-options-field filter-options-anchor"
              ItemsSource="{Binding ScopeAnchorOptions}"
              SelectedItem="{Binding SubstringStartAnchorOption}"
            >
              <ToolTip.Tip>
                <controls:RichToolTip>
                  <TextBlock Classes="rich-tip-bullet" Text="• Left: position 1 is the first character." />
                  <TextBlock Classes="rich-tip-bullet" Text="• Right: position 1 is the last character." />
                </controls:RichToolTip>
              </ToolTip.Tip>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StringScopeAnchorOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="4" Classes="filter-options-suffix" Text="side (incl.)" />

            <TextBlock Grid.Row="2" Classes="filter-options-label" Text="End at position" />
            <controls:CompactNumericUpDown
              x:Name="SubstringEndSpinner"
              Grid.Row="2"
              Grid.Column="1"
              Minimum="1"
              Maximum="9999"
              FormatString="0"
              Value="{Binding SubstringEndPosition}"
            />
            <TextBlock Grid.Row="2" Grid.Column="2" Classes="filter-options-from-the" Text="from the" />
            <ComboBox
              Grid.Row="2"
              Grid.Column="3"
              Classes="filter-options-field filter-options-anchor"
              ItemsSource="{Binding ScopeAnchorOptions}"
              SelectedItem="{Binding SubstringEndAnchorOption}"
            >
              <ToolTip.Tip>
                <controls:RichToolTip>
                  <TextBlock Classes="rich-tip-bullet" Text="• Left: position 1 is the first character." />
                  <TextBlock Classes="rich-tip-bullet" Text="• Right: position 1 is the last character." />
                </controls:RichToolTip>
              </ToolTip.Tip>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StringScopeAnchorOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="4" Classes="filter-options-suffix" Text="side (incl.)" />
          </Grid>
        </controls:FieldsetGroup>

        <controls:FieldsetGroup Header="Token" IsVisible="{Binding ShowTokenOptions}">
          <StackPanel Spacing="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsGroupLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Classes="filter-options-label"
                Text="Separator:"
                ToolTip.Tip="Characters that split the value into tokens (e.g. - or space)."
              />
              <TextBox
                x:Name="TokenSeparatorBox"
                Grid.Column="1"
                Classes="filter-options-field"
                Text="{Binding TokenSeparator}"
                ToolTip.Tip="Characters that split the value into tokens (e.g. - or space)."
              />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsGroupLabel" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Classes="filter-options-label"
                Text="Token number:"
                ToolTip.Tip="1-based index of the token to transform (1 = first piece)."
              />
              <controls:CompactNumericUpDown
                x:Name="TokenNumberSpinner"
                Grid.Column="1"
                Minimum="1"
                Maximum="9999"
                FormatString="0"
                Value="{Binding TokenNumber}"
                ToolTip.Tip="1-based index of the token to transform (1 = first piece)."
              />
            </Grid>
          </StackPanel>
        </controls:FieldsetGroup>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
