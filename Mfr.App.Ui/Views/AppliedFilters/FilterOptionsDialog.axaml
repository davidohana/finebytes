<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.AppliedFilters"
  x:Class="Mfr.App.Ui.Views.AppliedFilters.FilterOptionsDialog"
  x:DataType="vm:FilterOptionsDialogViewModel"
  Title="Filter Options"
  Icon="/Assets/mfr.ico"
  Width="540"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
  ShowInTaskbar="False"
  FontFamily="{StaticResource FileListFont}"
  FontSize="{StaticResource FileListFontSize}"
  Foreground="{DynamicResource FileListForegroundBrush}"
>
  <Window.Styles>
    <Style Selector="TextBlock.filter-options-label">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.filter-options-suffix">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.filter-options-from-the">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.filter-options-group-title">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.filter-options-group">
      <Setter Property="Background" Value="{DynamicResource FileListAddressBarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="ComboBox.filter-options-field, TextBox.filter-options-field">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.filter-options-field">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.filter-options-anchor">
      <Setter Property="Width" Value="80" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="ComboBox.filter-options-anchor /template/ ContentPresenter#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,0,4,0" />
    </Style>
    <Style Selector="ComboBox.filter-options-field /template/ ContentPresenter#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="NumericUpDown.filter-options-field">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="4,0,0,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="ShowButtonSpinner" Value="True" />
      <Setter Property="ButtonSpinnerLocation" Value="Right" />
    </Style>
    <Style Selector="NumericUpDown.filter-options-spinner">
      <Setter Property="Width" Value="80" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="NumericUpDown.filter-options-field /template/ TextBox#PART_TextBox">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0,4,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown.filter-options-field /template/ ButtonSpinner#PART_Spinner">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ButtonSpinner">
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
          >
            <DockPanel>
              <Grid Width="16" DockPanel.Dock="Right" IsVisible="{TemplateBinding ShowButtonSpinner}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <RepeatButton
                  Name="PART_IncreaseButton"
                  MinWidth="0"
                  MinHeight="0"
                  Padding="0"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                >
                  <Path
                    Width="8"
                    Height="4"
                    Data="M0,5 L4.5,.5 9,5 6,5 4.5,3.5 3,5 z"
                    Fill="{DynamicResource FileListForegroundBrush}"
                    Stretch="Uniform"
                  />
                </RepeatButton>
                <RepeatButton
                  Name="PART_DecreaseButton"
                  Grid.Row="1"
                  MinWidth="0"
                  MinHeight="0"
                  Padding="0"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                >
                  <Path
                    Width="8"
                    Height="4"
                    Data="M0,0 L3,0 4.5,1.5 6,0 9,0 4.5,4.5 z"
                    Fill="{DynamicResource FileListForegroundBrush}"
                    Stretch="Uniform"
                  />
                </RepeatButton>
              </Grid>
              <ContentPresenter
                Name="PART_ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
              />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="NumericUpDown.filter-options-field RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.filter-options-radio">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton.filter-options-radio /template/ Ellipse#OuterEllipse">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="RadioButton.filter-options-radio /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="RadioButton.filter-options-radio /template/ Ellipse#CheckGlyph">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
    </Style>
    <Style Selector="RadioButton.filter-options-radio /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Button.filter-options-footer">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Padding" Value="12,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.filter-options-footer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="8"
      Margin="0,14,0,0"
    >
      <Button x:Name="OkButton" Classes="filter-options-footer" Content="OK" IsDefault="True" Click="_OnOkClick" />
      <Button Classes="filter-options-footer" Content="Cancel" IsCancel="True" Click="_OnCancelClick" />
    </StackPanel>

    <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Classes="filter-options-label" Text="Name:" />
        <TextBox Grid.Column="1" Classes="filter-options-field" Text="{Binding Name}" />
      </Grid>

      <StackPanel Spacing="8" IsVisible="{Binding HasApplyTo}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="filter-options-label" Text="Apply To:" />
          <ComboBox
            Grid.Column="1"
            Classes="filter-options-field"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding TargetGroups}"
            SelectedItem="{Binding SelectedTargetGroup}"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterTargetGroupOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox
            Grid.Column="3"
            Classes="filter-options-field"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding TargetOptions}"
            SelectedItem="{Binding SelectedTargetOption}"
          >
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterTargetOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Grid IsVisible="{Binding HasAncestorFolderLevel}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="filter-options-label" Text="Level:" />
          <NumericUpDown
            x:Name="AncestorFolderLevelSpinner"
            Grid.Column="1"
            Classes="filter-options-field filter-options-spinner"
            Minimum="1"
            Maximum="99"
            FormatString="0"
            Value="{Binding AncestorFolderLevel}"
          />
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="filter-options-label" Text="Apply on:" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton
              Classes="filter-options-radio"
              GroupName="ApplyScope"
              Content="Whole"
              IsChecked="{Binding IsWholeScope, Mode=TwoWay}"
            />
            <RadioButton
              Classes="filter-options-radio"
              GroupName="ApplyScope"
              Content="Substring"
              IsChecked="{Binding IsSubstringScopeMode, Mode=TwoWay}"
            />
            <RadioButton
              Classes="filter-options-radio"
              GroupName="ApplyScope"
              Content="Token"
              IsChecked="{Binding IsTokenScopeMode, Mode=TwoWay}"
            />
          </StackPanel>
        </Grid>

        <Border Classes="filter-options-group" IsVisible="{Binding IsSubstringScope}">
          <StackPanel>
            <TextBlock Classes="filter-options-group-title" Text="Substring" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Classes="filter-options-label" Text="Start at position" />
              <NumericUpDown
                x:Name="SubstringStartSpinner"
                Grid.Column="1"
                Classes="filter-options-field filter-options-spinner"
                Minimum="1"
                Maximum="9999"
                FormatString="0"
                Value="{Binding SubstringStartPosition}"
              />
              <TextBlock Grid.Column="2" Classes="filter-options-from-the" Text="from the" />
              <ComboBox
                Grid.Column="3"
                Classes="filter-options-field filter-options-anchor"
                ItemsSource="{Binding ScopeAnchorOptions}"
                SelectedItem="{Binding SubstringStartAnchorOption}"
              >
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StringScopeAnchorOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="4" Classes="filter-options-suffix" Text="side (incl.)" />

              <TextBlock Grid.Row="2" Classes="filter-options-label" Text="End at position" />
              <NumericUpDown
                x:Name="SubstringEndSpinner"
                Grid.Row="2"
                Grid.Column="1"
                Classes="filter-options-field filter-options-spinner"
                Minimum="1"
                Maximum="9999"
                FormatString="0"
                Value="{Binding SubstringEndPosition}"
              />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="filter-options-from-the" Text="from the" />
              <ComboBox
                Grid.Row="2"
                Grid.Column="3"
                Classes="filter-options-field filter-options-anchor"
                ItemsSource="{Binding ScopeAnchorOptions}"
                SelectedItem="{Binding SubstringEndAnchorOption}"
              >
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StringScopeAnchorOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="2" Grid.Column="4" Classes="filter-options-suffix" Text="side (incl.)" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="filter-options-group" IsVisible="{Binding IsTokenScope}">
          <StackPanel Spacing="8">
            <TextBlock Classes="filter-options-group-title" Text="Token" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Classes="filter-options-label" Text="Separator:" />
              <TextBox Grid.Column="1" Classes="filter-options-field" Text="{Binding TokenSeparator}" />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterOptionsLabel" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Classes="filter-options-label" Text="Token number:" />
              <NumericUpDown
                x:Name="TokenNumberSpinner"
                Grid.Column="1"
                Classes="filter-options-field filter-options-spinner"
                Minimum="1"
                Maximum="9999"
                FormatString="0"
                Value="{Binding TokenNumber}"
              />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
