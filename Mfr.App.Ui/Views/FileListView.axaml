<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mfr.App.Ui.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="280"
             d:DesignHeight="400"
             x:Class="Mfr.App.Ui.Views.FileListView"
             x:DataType="vm:FileListViewModel">
    <Border Classes="pane">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="pane-header" Text="File Explorer" />

            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                  Margin="4,0,4,4">
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding PathHistory}"
                          Text="{Binding PathText, Mode=TwoWay}"
                          KeyDown="_OnPathKeyDown"
                          LostFocus="_OnPathLostFocus" />
                <Button Grid.Column="1"
                        Content="◀"
                        MinWidth="32"
                        Padding="6,2"
                        Margin="4,0,0,0"
                        Command="{Binding GoBackCommand}"
                        ToolTip.Tip="Back" />
                <Button Grid.Column="2"
                        Content="▶"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding GoForwardCommand}"
                        ToolTip.Tip="Forward" />
                <Button Grid.Column="3"
                        Content="▲"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding GoUpCommand}"
                        ToolTip.Tip="Up" />
                <Button Grid.Column="4"
                        Content="↻"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh" />
            </Grid>

            <Grid DockPanel.Dock="Bottom"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  Margin="4">
                <TextBlock Text="Mask:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Grid.Column="1"
                          IsEditable="True"
                          ItemsSource="{Binding MaskSuggestions}"
                          Text="{Binding Mask, Mode=TwoWay}" />
                <TextBlock Grid.Column="2"
                           Text="Exclude:"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0" />
                <TextBox Grid.Column="3"
                         MinWidth="72"
                         Watermark="*.tmp; *.bak"
                         Text="{Binding ExcludeMasks, Mode=TwoWay}" />
            </Grid>

            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Extended"
                      DoubleTapped="_OnEntriesDoubleTapped"
                      KeyDown="_OnEntriesKeyDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FileListEntry">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="16"
                                           Height="16"
                                           VerticalAlignment="Center"
                                           Source="{Binding Icon}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
