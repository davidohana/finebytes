<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mfr.App.Ui.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="280"
             d:DesignHeight="400"
             x:Class="Mfr.App.Ui.Views.FileListView"
             x:DataType="vm:FileListViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.file-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="ListBox.file-icons">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridCell">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>
    <Border Classes="pane">
        <DockPanel>
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                  Margin="4">
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding PathHistory}"
                          Text="{Binding PathText, Mode=TwoWay}"
                          KeyDown="_OnPathKeyDown"
                          LostFocus="_OnPathLostFocus" />
                <Button Grid.Column="1"
                        Content="◀"
                        MinWidth="32"
                        Padding="6,2"
                        Margin="4,0,0,0"
                        Command="{Binding GoBackCommand}"
                        ToolTip.Tip="Back" />
                <Button Grid.Column="2"
                        Content="▶"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding GoForwardCommand}"
                        ToolTip.Tip="Forward" />
                <Button Grid.Column="3"
                        Content="▲"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding GoUpCommand}"
                        ToolTip.Tip="Up" />
                <Button Grid.Column="4"
                        Content="↻"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh" />
            </Grid>

            <Grid DockPanel.Dock="Bottom"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  Margin="4">
                <TextBlock Text="Mask:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Grid.Column="1"
                          IsEditable="True"
                          ItemsSource="{Binding MaskSuggestions}"
                          Text="{Binding Mask, Mode=TwoWay}" />
                <TextBlock Grid.Column="2"
                           Text="Exclude:"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0" />
                <TextBox Grid.Column="3"
                         MinWidth="72"
                         Watermark="*.tmp; *.bak"
                         Text="{Binding ExcludeMasks, Mode=TwoWay}" />
            </Grid>

            <Panel>
                <DataGrid Classes="file-report"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          IsVisible="{Binding IsReportView}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="20"
                          SelectionMode="Extended"
                          DoubleTapped="_OnEntriesDoubleTapped"
                          KeyDown="_OnEntriesKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name"
                                                Width="*"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileListEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Image Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"
                                               Source="{Binding Icon}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date modified"
                                            Binding="{Binding DateModifiedDisplay}"
                                            SortMemberPath="LastWriteTime"
                                            Width="140" />
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding Type}"
                                            Width="110" />
                        <DataGridTemplateColumn Header="Size"
                                                Width="72"
                                                SortMemberPath="Length">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileListEntry">
                                    <TextBlock Text="{Binding SizeDisplay}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ListBox Classes="file-list"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsListView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsSmallIconsView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Orientation="Horizontal"
                                        MaxWidth="140"
                                        Spacing="4">
                                <Image Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsLargeIconsView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Width="72" Margin="2,1">
                                <Image Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsTilesView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Orientation="Horizontal"
                                        Width="168"
                                        Spacing="4"
                                        Margin="1">
                                <Image Width="32"
                                       Height="32"
                                       VerticalAlignment="Top"
                                       Source="{Binding Icon}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}"
                                               Opacity="0.7"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsThumbnailsView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Width="100" Margin="2,1">
                                <Image Width="96"
                                       Height="96"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
