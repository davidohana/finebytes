<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Mfr.App.Ui.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="280"
             d:DesignHeight="400"
             x:Class="Mfr.App.Ui.Views.FileListView"
             x:Name="FileListRoot"
             x:DataType="vm:FileListViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FileListRowBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FileListAltRowBrush" Color="#F6F6F6" />
                    <SolidColorBrush x:Key="FileListSelectionBrush" Color="#CCE8FF" />
                    <SolidColorBrush x:Key="FileListSelectionBorderBrush" Color="#99D1FF" />
                    <SolidColorBrush x:Key="FileListHoverBrush" Color="#E5F3FF" />
                    <SolidColorBrush x:Key="FileListHeaderBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="FileListHeaderForegroundBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="FileListSeparatorBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="FileListForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="FileListAddressBarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FileListAddressBarBorderBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="FileListBreadcrumbMutedBrush" Color="#5C5C5C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FileListRowBrush" Color="#202020" />
                    <SolidColorBrush x:Key="FileListAltRowBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="FileListSelectionBrush" Color="#264F78" />
                    <SolidColorBrush x:Key="FileListSelectionBorderBrush" Color="#3A6A9A" />
                    <SolidColorBrush x:Key="FileListHoverBrush" Color="#2A3F55" />
                    <SolidColorBrush x:Key="FileListHeaderBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="FileListHeaderForegroundBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="FileListSeparatorBrush" Color="#3F3F3F" />
                    <SolidColorBrush x:Key="FileListForegroundBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="FileListAddressBarBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="FileListAddressBarBorderBrush" Color="#3F3F3F" />
                    <SolidColorBrush x:Key="FileListBreadcrumbMutedBrush" Color="#B0B0B0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="FileListFont">Segoe UI, SegoeUI</FontFamily>
            <x:Double x:Key="FileListFontSize">12</x:Double>
            <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
            <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
            <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
            <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
            <Thickness x:Key="DataGridTextColumnCellTextBlockMargin">6,0,6,0</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox.file-list">
            <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
            <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
        </Style>
        <Style Selector="ListBox.file-icons">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
        </Style>
        <Style Selector="ListBox.file-rows ListBoxItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
        </Style>
        <Style Selector="ListBox.file-rows ListBoxItem:nth-child(even)">
            <Setter Property="Background" Value="{DynamicResource FileListAltRowBrush}" />
        </Style>
        <Style Selector="ListBox.file-icons ListBoxItem">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="2,1" />
        </Style>
        <Style Selector="ListBox.file-small-icons ListBoxItem">
            <Setter Property="Width" Value="120" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
        </Style>
        <Style Selector="DataGrid.file-report">
            <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
            <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource FileListRowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="22" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
            <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource FileListHeaderForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource FileListHeaderBrush}" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="6,0,4,0" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource FileListSeparatorBrush}" />
            <Setter Property="AreSeparatorsVisible" Value="True" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow:nth-child(even)">
            <Setter Property="Background" Value="{DynamicResource FileListAltRowBrush}" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridCell">
            <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
            <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource FileListHoverBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGrid.file-report DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.address-bar">
            <Setter Property="Background" Value="{DynamicResource FileListAddressBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="2,0,0,0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>
        <Style Selector="Button.breadcrumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
            <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.breadcrumb /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.breadcrumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.address-history">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.address-history:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
        </Style>
        <Style Selector="TextBox.address-edit">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
            <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="SelectionBrush" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource FileListForegroundBrush}" />
        </Style>
        <Style Selector="TextBox.address-edit /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="SelectionBrush" Value="{DynamicResource FileListSelectionBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource FileListForegroundBrush}" />
        </Style>
    </UserControl.Styles>
    <Border Classes="pane">
        <DockPanel>
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                  Margin="4">
                <Border x:Name="AddressBar"
                        Classes="address-bar"
                        PointerPressed="_OnAddressBarPointerPressed">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding !IsPathEditing}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Classes="breadcrumb"
                                        Focusable="False"
                                        Margin="2,0,0,0"
                                        Command="{Binding BeginPathEditCommand}"
                                        ToolTip.Tip="Click to type or paste a path">
                                    <Panel Width="16" Height="16">
                                        <Viewbox IsVisible="{Binding ShowsComputerRoot}">
                                            <Path Width="16"
                                                  Height="16"
                                                  Stretch="Uniform"
                                                  Fill="{DynamicResource FileListForegroundBrush}"
                                                  Data="M1.5,2.5 H14.5 A1,1 0 0 1 15.5,3.5 V10.5 A1,1 0 0 1 14.5,11.5 H1.5 A1,1 0 0 1 0.5,10.5 V3.5 A1,1 0 0 1 1.5,2.5 Z M5,13 H11 V14.5 H5 Z M0,15 H16 V16 H0 Z" />
                                        </Viewbox>
                                        <Viewbox IsVisible="{Binding !ShowsComputerRoot}">
                                            <Path Width="16"
                                                  Height="16"
                                                  Stretch="Uniform"
                                                  Fill="{DynamicResource FileListForegroundBrush}"
                                                  Data="M1,13 V5 H5 L6.5,3 H12.5 L14,5 H15 V13 Z" />
                                        </Viewbox>
                                    </Panel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding BreadcrumbSegments}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PathBreadcrumbSegment">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Cursor="Arrow">
                                                <Path Width="6"
                                                      Height="10"
                                                      Margin="4,0"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding ShowLeadingChevron}"
                                                      Stroke="{DynamicResource FileListBreadcrumbMutedBrush}"
                                                      StrokeThickness="1.25"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round"
                                                      Data="M1,1.5 L5,5 L1,8.5" />
                                                <Button Classes="breadcrumb"
                                                        Content="{Binding Label}"
                                                        ToolTip.Tip="{Binding TargetPath}"
                                                        Command="{Binding #FileListRoot.((vm:FileListViewModel)DataContext).NavigateToCommand}"
                                                        CommandParameter="{Binding TargetPath}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border MinWidth="28"
                                        Background="Transparent"
                                        VerticalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBox x:Name="PathEditBox"
                                 Classes="address-edit"
                                 IsVisible="{Binding IsPathEditing}"
                                 Text="{Binding PathText, Mode=TwoWay}"
                                 Watermark="Paste or type a folder path"
                                 KeyDown="_OnPathKeyDown"
                                 LostFocus="_OnPathLostFocus" />
                        <Button x:Name="HistoryButton"
                                Grid.Column="1"
                                Classes="address-history"
                                Focusable="False"
                                Click="_OnHistoryClick"
                                ToolTip.Tip="Recent locations">
                            <Path Width="10"
                                  Height="6"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource FileListBreadcrumbMutedBrush}"
                                  Data="M0,0 L10,0 L5,6 Z" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight"
                                        Opened="_OnHistoryOpened"
                                        Closed="_OnHistoryClosed">
                                    <ListBox MaxHeight="220"
                                             MinWidth="280"
                                             ItemsSource="{Binding PathHistory}"
                                             Tapped="_OnHistoryTapped" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>
                <Button Grid.Column="1"
                        Content="◀"
                        MinWidth="32"
                        Padding="6,2"
                        Margin="4,0,0,0"
                        Command="{Binding GoBackCommand}"
                        ToolTip.Tip="Back" />
                <Button Grid.Column="2"
                        Content="▶"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding GoForwardCommand}"
                        ToolTip.Tip="Forward" />
                <Button Grid.Column="3"
                        Content="▲"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding GoUpCommand}"
                        ToolTip.Tip="Up" />
                <Button Grid.Column="4"
                        Content="↻"
                        MinWidth="32"
                        Padding="6,2"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh" />
            </Grid>

            <Grid DockPanel.Dock="Bottom"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  Margin="4">
                <TextBlock Text="Mask:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Grid.Column="1"
                          IsEditable="True"
                          ItemsSource="{Binding MaskSuggestions}"
                          Text="{Binding Mask, Mode=TwoWay}" />
                <TextBlock Grid.Column="2"
                           Text="Exclude:"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0" />
                <TextBox Grid.Column="3"
                         MinWidth="72"
                         Watermark="*.tmp; *.bak"
                         Text="{Binding ExcludeMasks, Mode=TwoWay}" />
            </Grid>

            <Panel>
                <DataGrid Classes="file-report"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          IsVisible="{Binding IsReportView}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="20"
                          ColumnHeaderHeight="22"
                          SelectionMode="Extended"
                          Sorting="_OnEntriesSorting"
                          Loaded="_OnReportGridLoaded"
                          DoubleTapped="_OnEntriesDoubleTapped"
                          KeyDown="_OnEntriesKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name"
                                                Width="*"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileListEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Image Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"
                                               Source="{Binding Icon}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Date modified"
                                                Width="140"
                                                SortMemberPath="LastWriteTime">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileListEntry">
                                    <TextBlock Text="{Binding DateModifiedDisplay}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding Type}"
                                            SortMemberPath="Type"
                                            Width="110" />
                        <DataGridTemplateColumn Header="Size"
                                                Width="80"
                                                SortMemberPath="Length">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:FileListEntry">
                                    <TextBlock Text="{Binding SizeDisplay}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Padding="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ListBox Classes="file-list file-rows"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsListView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons file-small-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsSmallIconsView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="120" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsLargeIconsView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Width="72" Margin="2,1">
                                <Image Width="32"
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsTilesView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Orientation="Horizontal"
                                        Width="168"
                                        Spacing="4"
                                        Margin="1">
                                <Image Width="32"
                                       Height="32"
                                       VerticalAlignment="Top"
                                       Source="{Binding Icon}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}"
                                               Opacity="0.7"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Classes="file-list file-icons"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsVisible="{Binding IsThumbnailsView}"
                         SelectionMode="Multiple"
                         DoubleTapped="_OnEntriesDoubleTapped"
                         KeyDown="_OnEntriesKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileListEntry">
                            <StackPanel Width="100" Margin="2,1">
                                <Image Width="96"
                                       Height="96"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Source="{Binding Icon}" />
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
