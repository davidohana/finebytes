<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Mfr.App.Ui.Views.TextInputDialog"
  Icon="/Assets/mfr.ico"
  Width="480"
  MinWidth="360"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="False"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <DockPanel Margin="14">
    <StackPanel
      x:Name="Footer"
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="8"
      Margin="0,16,0,0"
    >
      <Button x:Name="OkButton" Classes="message-dialog-footer" Content="OK" IsDefault="True" Click="_OnOkClick" />
      <Button
        x:Name="CancelButton"
        Classes="message-dialog-footer"
        Content="Cancel"
        IsCancel="True"
        Click="_OnCancelClick"
      />
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
      <TextBlock
        x:Name="NoteText"
        TextWrapping="Wrap"
        Foreground="{DynamicResource AppChromeMutedForegroundBrush}"
      />
      <TextBox x:Name="ValueBox" Margin="0,2,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
