<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.About"
  x:Class="Mfr.App.Ui.Views.About.AboutDialog"
  x:DataType="vm:AboutDialogViewModel"
  Title="About"
  Icon="/Assets/mfr.ico"
  Width="520"
  MinWidth="480"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="False"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
  Background="{DynamicResource AppChromeSurfaceBrush}"
>
  <Window.Styles>
    <Style Selector="HyperlinkButton.about-link">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontFamily" Value="{DynamicResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{DynamicResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="HyperlinkButton.about-link:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AppChromeMutedForegroundBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="20">
    <StackPanel
      x:Name="Footer"
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,18,0,0"
    >
      <Button
        x:Name="OkButton"
        Classes="message-dialog-footer"
        Content="OK"
        IsDefault="True"
        IsCancel="True"
        Click="_OnOkClick"
      />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
      <Image
        x:Name="SplashImage"
        Grid.Column="0"
        Width="220"
        Height="210"
        Stretch="Uniform"
        VerticalAlignment="Top"
        Source="/Assets/mfr.png"
      />

      <Border
        Grid.Column="1"
        Background="{DynamicResource AppChromeAltSurfaceBrush}"
        BorderBrush="{DynamicResource AppChromeBorderBrush}"
        BorderThickness="1"
        CornerRadius="4"
        Padding="16,14"
        MinHeight="210"
      >
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="14" Margin="0,16,0,0">
            <HyperlinkButton Classes="about-link" Content="Web Site" Command="{Binding OpenWebSiteCommand}" />
            <TextBlock
              Text="·"
              VerticalAlignment="Center"
              Foreground="{DynamicResource AppChromeMutedForegroundBrush}"
            />
            <HyperlinkButton
              Classes="about-link"
              Content="Support e-mail"
              Command="{Binding OpenSupportEmailCommand}"
            />
          </StackPanel>

          <StackPanel Spacing="6" VerticalAlignment="Top">
            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
            <TextBlock
              Text="{Binding DisplayVersion, StringFormat=Version {0}}"
              Foreground="{DynamicResource AppChromeMutedForegroundBrush}"
            />
            <TextBlock
              Text="{Binding BetaExpiryNotice}"
              TextWrapping="Wrap"
              Margin="0,8,0,0"
              Foreground="{DynamicResource AppChromeMutedForegroundBrush}"
            />
            <TextBlock
              Text="{Binding Copyright}"
              TextWrapping="Wrap"
              Margin="0,8,0,0"
              Foreground="{DynamicResource AppChromeMutedForegroundBrush}"
            />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
