<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.Presets"
  xmlns:models="using:Mfr.Models.Filters"
  x:Class="Mfr.App.Ui.Views.Presets.PresetManagerDialog"
  x:DataType="vm:PresetManagerDialogViewModel"
  Title="Presets"
  Icon="/Assets/FilterChain/Presets.png"
  Width="640"
  Height="420"
  MinWidth="560"
  MinHeight="320"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="True"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <Window.Styles>
    <Style Selector="TextBlock.preset-manager-title">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.preset-manager-subtitle">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeMutedForegroundBrush}" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.preset-manager-section">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="ListBox.preset-manager-list">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.preset-manager-list ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.preset-manager-description">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.preset-manager-description-name">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeForegroundBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.preset-manager-description-body">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeMutedForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style Selector="TextBlock.preset-manager-description-empty">
      <Setter Property="FontFamily" Value="{StaticResource AppChromeFont}" />
      <Setter Property="FontSize" Value="{StaticResource AppChromeFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource AppChromeMutedForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.preset-manager-action">
      <Setter Property="MinWidth" Value="118" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="StackPanel.preset-manager-reorder">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Classes="preset-manager-title" Text="Preset library" />
      <TextBlock Classes="preset-manager-subtitle" Text="Load, reorder, or manage saved rename chains." />
    </StackPanel>

    <Grid ColumnDefinitions="*,12,Auto,12,*,14,Auto" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Grid.Column="0" Classes="preset-manager-section" Text="Presets" />
      <TextBlock Grid.Row="0" Grid.Column="4" Classes="preset-manager-section" Text="Description" />

      <ListBox
        x:Name="PresetsList"
        Grid.Row="1"
        Grid.Column="0"
        Classes="preset-manager-list"
        SelectionMode="Multiple"
        ItemsSource="{Binding Presets}"
        DoubleTapped="_OnPresetsListDoubleTapped"
        KeyDown="_OnPresetsListKeyDown"
      >
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:FilterPreset">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="1" Grid.Column="2" Classes="preset-manager-reorder" Orientation="Vertical">
        <Button
          x:Name="MoveUpButton"
          Classes="tool-action"
          ToolTip.Tip="Move up"
          Command="{Binding MoveSelectedUpCommand}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveUp.png" />
        </Button>
        <Button
          x:Name="MoveDownButton"
          Classes="tool-action"
          ToolTip.Tip="Move down"
          Command="{Binding MoveSelectedDownCommand}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveDown.png" />
        </Button>
      </StackPanel>

      <Border Grid.Row="1" Grid.Column="4" Classes="preset-manager-description">
        <Panel>
          <TextBlock
            Classes="preset-manager-description-empty"
            IsVisible="{Binding !HasSingleSelection}"
            Text="Select one preset to see its description."
          />
          <ScrollViewer
            IsVisible="{Binding HasSingleSelection}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
          >
            <StackPanel>
              <TextBlock Classes="preset-manager-description-name" Text="{Binding SelectedName}" />
              <TextBlock Classes="preset-manager-description-body" Text="{Binding SelectedDescription}" />
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>

      <Grid Grid.Row="1" Grid.Column="6" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="8">
          <Button
            x:Name="LoadButton"
            Classes="message-dialog-footer preset-manager-action"
            Content="Load"
            IsDefault="True"
            IsEnabled="{Binding HasSingleSelection}"
            Click="_OnLoadClick"
          />
          <Button
            x:Name="RenameButton"
            Classes="message-dialog-footer preset-manager-action"
            Content="Rename"
            IsEnabled="{Binding HasSingleSelection}"
            Click="_OnRenameClick"
          />
          <Button
            x:Name="DeleteButton"
            Classes="message-dialog-footer preset-manager-action"
            Content="Delete"
            IsEnabled="{Binding HasSelection}"
            Click="_OnDeleteClick"
          />
          <Button
            x:Name="ImportSamplesButton"
            Classes="message-dialog-footer preset-manager-action"
            Content="Import samples…"
            Click="_OnImportSamplesClick"
          />
        </StackPanel>
        <Button
          x:Name="CloseButton"
          Grid.Row="2"
          Classes="message-dialog-footer preset-manager-action"
          Content="Close"
          IsCancel="True"
          Click="_OnCloseClick"
        />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
