<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.Presets"
  xmlns:models="using:Mfr.Models.Filters"
  x:Class="Mfr.App.Ui.Views.Presets.PresetManagerDialog"
  x:DataType="vm:PresetManagerDialogViewModel"
  Title="Presets"
  Icon="/Assets/mfr.ico"
  Width="620"
  Height="380"
  MinWidth="540"
  MinHeight="300"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="True"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <Window.Styles>
    <Style Selector="ListBox.preset-manager-list">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ListBox.preset-manager-list ListBoxItem">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="ListBox.preset-manager-list ListBoxItem.drop-mark">
      <Setter Property="Background" Value="{DynamicResource DropMarkBrush}" />
    </Style>
    <Style Selector="ListBox.preset-manager-list ListBoxItem.drop-mark:selected">
      <Setter Property="Background" Value="{DynamicResource DropMarkBrush}" />
    </Style>
    <Style Selector="ListBox.preset-manager-list ListBoxItem.drop-mark:pointerover">
      <Setter Property="Background" Value="{DynamicResource DropMarkBrush}" />
    </Style>
    <Style Selector="Border.preset-manager-description">
      <Setter Property="Background" Value="{DynamicResource AppChromeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppChromeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.preset-manager-action">
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid Margin="12" ColumnDefinitions="*,Auto,12,*,12,Auto" RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Presets:" Margin="0,0,0,6" />
    <TextBlock Grid.Row="0" Grid.Column="3" Text="Description:" Margin="0,0,0,6" />

    <ListBox
      x:Name="PresetsList"
      Grid.Row="1"
      Grid.Column="0"
      Classes="preset-manager-list"
      SelectionMode="Multiple"
      ItemsSource="{Binding Presets}"
      DoubleTapped="_OnPresetsListDoubleTapped"
      KeyDown="_OnPresetsListKeyDown"
    >
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:FilterPreset">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel
      Grid.Row="1"
      Grid.Column="1"
      Orientation="Vertical"
      VerticalAlignment="Center"
      Spacing="4"
      Margin="4,0,0,0"
    >
      <Button
        x:Name="MoveUpButton"
        Classes="rename-list-action"
        ToolTip.Tip="Move up"
        Command="{Binding MoveSelectedUpCommand}"
      >
        <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveUp.png" />
      </Button>
      <Button
        x:Name="MoveDownButton"
        Classes="rename-list-action"
        ToolTip.Tip="Move down"
        Command="{Binding MoveSelectedDownCommand}"
      >
        <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveDown.png" />
      </Button>
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="3" Classes="preset-manager-description">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="8">
        <Button
          x:Name="LoadButton"
          Classes="message-dialog-footer preset-manager-action"
          Content="Load"
          IsDefault="True"
          IsEnabled="{Binding HasSingleSelection}"
          Click="_OnLoadClick"
        />
        <Button
          x:Name="RenameButton"
          Classes="message-dialog-footer preset-manager-action"
          Content="Rename"
          IsEnabled="{Binding HasSingleSelection}"
          Click="_OnRenameClick"
        />
        <Button
          x:Name="DeleteButton"
          Classes="message-dialog-footer preset-manager-action"
          Content="Delete"
          IsEnabled="{Binding HasSelection}"
          Click="_OnDeleteClick"
        />
        <Button
          x:Name="ImportSamplesButton"
          Classes="message-dialog-footer preset-manager-action"
          Content="Import samples…"
          Click="_OnImportSamplesClick"
        />
      </StackPanel>
      <Button
        x:Name="CloseButton"
        Grid.Row="2"
        Classes="message-dialog-footer preset-manager-action"
        Content="Close"
        IsCancel="True"
        Click="_OnCloseClick"
      />
    </Grid>
  </Grid>
</Window>
