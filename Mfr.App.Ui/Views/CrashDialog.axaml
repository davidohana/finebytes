<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels"
  x:Class="Mfr.App.Ui.Views.CrashDialog"
  x:DataType="vm:CrashDialogViewModel"
  Title="Magic File Renamer"
  Width="640"
  Height="480"
  MinWidth="420"
  MinHeight="320"
  WindowStartupLocation="CenterOwner"
  CanResize="True"
>
  <DockPanel Margin="16">
    <TextBlock
      DockPanel.Dock="Top"
      Text="{Binding Summary}"
      TextWrapping="Wrap"
      FontWeight="SemiBold"
      Margin="0,0,0,12"
    />
    <TextBlock DockPanel.Dock="Top" Text="Log file" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox
      DockPanel.Dock="Top"
      Text="{Binding LogFileDisplay}"
      IsReadOnly="True"
      AcceptsReturn="True"
      TextWrapping="Wrap"
      Margin="0,0,0,12"
    />
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Spacing="8"
      Margin="0,12,0,0"
    >
      <Button Content="Copy details" Click="_OnCopyDetailsClick" />
      <Button
        Content="Open log folder"
        IsEnabled="{Binding HasLogDirectory}"
        Click="_OnOpenLogFolderClick"
      />
      <Button Content="OK" IsDefault="True" IsCancel="True" Click="_OnOkClick" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="Details" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBox
      Text="{Binding Details}"
      IsReadOnly="True"
      AcceptsReturn="True"
      TextWrapping="Wrap"
      FontFamily="Consolas,Menlo,monospace"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
    />
  </DockPanel>
</Window>
