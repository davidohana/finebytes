<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Misc"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="160"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Misc.FixLeadingZerosFilterEditorView"
  x:DataType="vm:FixLeadingZerosFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6">
        <StackPanel
          Orientation="Horizontal"
          Spacing="4"
          ToolTip.Tip="Target digit count. Shorter numbers are padded with leading zeros. Longer numbers stay unchanged unless the shrink option below is checked."
        >
          <TextBlock
            Classes="filter-editor-label"
            VerticalAlignment="Center"
            Text="Target width of"
          />
          <controls:CompactNumericUpDown
            x:Name="WidthSpinner"
            Width="56"
            Minimum="1"
            Maximum="30"
            Increment="1"
            FormatString="0"
            Value="{Binding Width}"
          />
          <TextBlock Classes="filter-editor-label" VerticalAlignment="Center" Text="digits" />
        </StackPanel>
        <controls:CompactCheckBox
          x:Name="RemoveExtraZerosCheckBox"
          Content="Also shrink longer numbers to this width"
          ToolTip.Tip="When unchecked, only pad shorter numbers (e.g. 7 → 007). When checked, strip surplus leading zeros first so over-padded numbers shrink to the target width (e.g. width 3: 0007 → 007)."
          IsChecked="{Binding RemoveExtraZeros}"
        />
        <controls:CompactCheckBox
          x:Name="WholeWordOnlyCheckBox"
          Content="Whole word only"
          ToolTip.Tip="Skip digit groups that have a letter immediately before or after (e.g. leave the 1 in doc1 alone)."
          IsChecked="{Binding WholeWordOnly}"
        />
        <StackPanel
          Orientation="Horizontal"
          Spacing="4"
          ToolTip.Tip="Limit how many digit groups are changed, left to right. 0 means fix every match."
        >
          <TextBlock
            Classes="filter-editor-label"
            VerticalAlignment="Center"
            Text="Maximum numbers to fix (0 = all):"
          />
          <controls:CompactNumericUpDown
            x:Name="MaxCountSpinner"
            Width="64"
            Minimum="0"
            Maximum="9999"
            Increment="1"
            FormatString="0"
            Value="{Binding MaxCount}"
          />
        </StackPanel>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
