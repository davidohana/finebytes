<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Misc"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="160"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Misc.FixLeadingZerosFilterEditorView"
  x:DataType="vm:FixLeadingZerosFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Target digit count." />
              <TextBlock Classes="rich-tip-bullet" Text="• Shorter numbers are padded with leading zeros." />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Longer numbers stay unchanged unless the shrink option below is checked."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBlock Classes="filter-editor-label" VerticalAlignment="Center" Text="Target width of" />
          <controls:CompactNumericUpDown
            x:Name="WidthSpinner"
            Width="56"
            Minimum="1"
            Maximum="30"
            Increment="1"
            FormatString="0"
            Value="{Binding Width}"
          />
          <TextBlock Classes="filter-editor-label" VerticalAlignment="Center" Text="digits" />
        </StackPanel>
        <controls:CompactCheckBox
          x:Name="RemoveExtraZerosCheckBox"
          Content="Also shrink longer numbers to this width"
          IsChecked="{Binding RemoveExtraZeros}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-bullet" Text="• Unchecked: only pad shorter numbers (e.g. 7 → 007)." />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Checked: strip surplus leading zeros first so over-padded numbers shrink (e.g. width 3: 0007 → 007)."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactCheckBox>
        <controls:CompactCheckBox
          x:Name="WholeWordOnlyCheckBox"
          Content="Whole word only"
          ToolTip.Tip="Skip digit groups that have a letter immediately before or after (e.g. leave the 1 in doc1 alone)."
          IsChecked="{Binding WholeWordOnly}"
        />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-body" Text="Limit how many digit groups are changed, left to right." />
              <TextBlock Classes="rich-tip-bullet" Text="• 0 means fix every match." />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBlock
            Classes="filter-editor-label"
            VerticalAlignment="Center"
            Text="Maximum numbers to fix (0 = all):"
          />
          <controls:CompactNumericUpDown
            x:Name="MaxCountSpinner"
            Width="64"
            Minimum="0"
            Maximum="9999"
            Increment="1"
            FormatString="0"
            Value="{Binding MaxCount}"
          />
        </StackPanel>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
