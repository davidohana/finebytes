<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Space"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:converters="using:Mfr.App.Ui.Converters"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="220"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Space.SpaceCharacterFilterEditorView"
  x:DataType="vm:SpaceCharacterFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Define">
      <StackPanel Spacing="6">
        <ToolTip.Tip>
          <controls:RichToolTip>
            <TextBlock Classes="rich-tip-body" Text="Sets the word separator for later filters (e.g. Capitalize)." />
            <TextBlock
              Classes="rich-tip-bullet"
              Text="• Replacements below convert other separators into this character."
            />
          </controls:RichToolTip>
        </ToolTip.Tip>
        <TextBlock
          Classes="filter-editor-label"
          Text="Use the following character to separate between words:"
          TextWrapping="Wrap"
        />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <controls:CompactRadioButton
            x:Name="SpaceDefinitionRadio"
            GroupName="SpaceCharacterDefinition"
            Content="Space"
            IsChecked="{Binding Definition, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:SpaceCharacterDefinition.Space}, Mode=TwoWay}"
          />
          <controls:CompactRadioButton
            x:Name="UnderscoreDefinitionRadio"
            GroupName="SpaceCharacterDefinition"
            Content="Underscore ( _ )"
            IsChecked="{Binding Definition, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:SpaceCharacterDefinition.Underscore}, Mode=TwoWay}"
          />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <controls:CompactRadioButton
              x:Name="OtherDefinitionRadio"
              GroupName="SpaceCharacterDefinition"
              Content="Other:"
              IsChecked="{Binding Definition, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static vm:SpaceCharacterDefinition.Other}, Mode=TwoWay}"
            />
            <TextBox
              x:Name="OtherCharacterBox"
              Classes="filter-editor-field"
              Width="28"
              MaxLength="1"
              ToolTip.Tip="Any single character to use as the word separator (e.g. - or .)."
              Text="{Binding OtherCharacter}"
            />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </controls:FieldsetGroup>
    <controls:FieldsetGroup Header="Replace">
      <StackPanel Spacing="6">
        <TextBlock
          Classes="filter-editor-label"
          Text="Replace the following with the defined space character:"
          TextWrapping="Wrap"
          ToolTip.Tip="Each checked form is rewritten to the defined separator. Unchecked forms are left unchanged."
        />
        <WrapPanel>
          <controls:CompactCheckBox
            x:Name="ReplaceSpacesCheckBox"
            Content="Spaces"
            IsChecked="{Binding ReplaceSpaces}"
          />
          <controls:CompactCheckBox
            x:Name="ReplaceUnderscoresCheckBox"
            Margin="12,0,0,0"
            Content="Underscores"
            IsChecked="{Binding ReplaceUnderscores}"
          />
          <controls:CompactCheckBox
            x:Name="ReplacePercent20CheckBox"
            Margin="12,0,0,0"
            Content="%20's"
            ToolTip.Tip="Replace the literal text %20 (common URL-encoded spaces)."
            IsChecked="{Binding ReplacePercent20}"
          />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:CompactCheckBox
            x:Name="ReplaceCustomCheckBox"
            Content="Custom text:"
            IsChecked="{Binding ReplaceCustom}"
          >
            <ToolTip.Tip>
              <controls:RichToolTip>
                <TextBlock Classes="rich-tip-body" Text="Replace this exact substring with the defined separator." />
                <TextBlock Classes="rich-tip-bullet" Text="• Example: ++ → -." />
              </controls:RichToolTip>
            </ToolTip.Tip>
          </controls:CompactCheckBox>
          <TextBox
            x:Name="CustomTextBox"
            Classes="filter-editor-field"
            MinWidth="120"
            ToolTip.Tip="Exact substring to replace when Custom text is checked."
            Text="{Binding CustomText}"
          />
        </StackPanel>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
