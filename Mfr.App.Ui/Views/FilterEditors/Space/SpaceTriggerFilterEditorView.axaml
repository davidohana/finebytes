<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Space"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:converters="using:Mfr.App.Ui.Converters"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="120"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Space.SpaceTriggerFilterEditorView"
  x:DataType="vm:SpaceTriggerFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6">
        <controls:LabelBesideFieldPanel>
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-body" Text="Characters that trigger inserting the word separator." />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Separator is set by Space Character (default U+0020 SPACE)."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBlock Classes="filter-editor-label" TextWrapping="Wrap" Text="{Binding CharsPrompt}" />
          <TextBox
            x:Name="CharsBox"
            Classes="filter-editor-field"
            MinWidth="120"
            MaxLength="100"
            Text="{Binding Chars}"
          />
        </controls:LabelBesideFieldPanel>
        <controls:CompactCheckBox
          x:Name="NeighborCheckBox"
          Content="{Binding NeighborCheckLabel}"
          ToolTip.Tip="{Binding NeighborCheckToolTip, Converter={x:Static converters:RichToolTipConverter.Instance}}"
          IsChecked="{Binding OnlyWhenNeighborLetterOrDigit}"
        />
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
