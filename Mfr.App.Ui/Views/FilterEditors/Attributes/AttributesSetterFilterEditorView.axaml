<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Attributes"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="160"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Attributes.AttributesSetterFilterEditorView"
  x:DataType="vm:AttributesSetterFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <ToolTip.Tip>
        <controls:RichToolTip>
          <TextBlock Classes="rich-tip-title" Text="Filesystem attribute flags." />
          <TextBlock Classes="rich-tip-bullet" Text="• On: turn the attribute on for every item." />
          <TextBlock Classes="rich-tip-bullet" Text="• Off: turn the attribute off for every item." />
          <TextBlock Classes="rich-tip-bullet" Text="• Keep: leave the attribute unchanged (default)." />
        </controls:RichToolTip>
      </ToolTip.Tip>
      <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
        <controls:AttributeTriStateRow
          x:Name="ReadOnlyRow"
          Label="Read-only:"
          GroupName="AttributesSetterReadOnly"
          Value="{Binding ReadOnly, Mode=TwoWay}"
        />
        <controls:AttributeTriStateRow
          x:Name="HiddenRow"
          Label="Hidden:"
          GroupName="AttributesSetterHidden"
          Value="{Binding Hidden, Mode=TwoWay}"
        />
        <controls:AttributeTriStateRow
          x:Name="ArchiveRow"
          Label="Archive:"
          GroupName="AttributesSetterArchive"
          Value="{Binding Archive, Mode=TwoWay}"
        />
        <controls:AttributeTriStateRow
          x:Name="SystemRow"
          Label="System:"
          GroupName="AttributesSetterSystem"
          Value="{Binding System, Mode=TwoWay}"
        />
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
