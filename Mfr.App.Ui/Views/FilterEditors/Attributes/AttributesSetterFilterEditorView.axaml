<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Attributes"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="140"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Attributes.AttributesSetterFilterEditorView"
  x:DataType="vm:AttributesSetterFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="4">
        <ToolTip.Tip>
          <controls:RichToolTip>
            <TextBlock Classes="rich-tip-title" Text="Filesystem attribute flags." />
            <TextBlock Classes="rich-tip-bullet" Text="• Checked: turn the attribute on for every item." />
            <TextBlock Classes="rich-tip-bullet" Text="• Unchecked: turn the attribute off for every item." />
            <TextBlock
              Classes="rich-tip-bullet"
              Text="• Gray (indeterminate): leave the attribute unchanged (default)."
            />
          </controls:RichToolTip>
        </ToolTip.Tip>
        <controls:CompactCheckBox
          x:Name="ReadOnlyCheckBox"
          Content="Read-only"
          IsThreeState="True"
          IsChecked="{Binding ReadOnlyChecked}"
        />
        <controls:CompactCheckBox
          x:Name="HiddenCheckBox"
          Content="Hidden"
          IsThreeState="True"
          IsChecked="{Binding HiddenChecked}"
        />
        <controls:CompactCheckBox
          x:Name="ArchiveCheckBox"
          Content="Archive"
          IsThreeState="True"
          IsChecked="{Binding ArchiveChecked}"
        />
        <controls:CompactCheckBox
          x:Name="SystemCheckBox"
          Content="System"
          IsThreeState="True"
          IsChecked="{Binding SystemChecked}"
        />
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
