<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="200"
  x:Class="Mfr.App.Ui.Views.FilterEditors.LettersCaseFilterEditorView"
  x:DataType="vm:LettersCaseFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Casing Style">
      <StackPanel Spacing="6">
        <UniformGrid Columns="3">
          <RadioButton
            x:Name="TitleCaseRadio"
            Classes="filter-editor-radio"
            GroupName="LettersCaseMode"
            Content="Capitalize"
            IsChecked="{Binding IsModeTitleCase, Mode=TwoWay}"
          />
          <RadioButton
            x:Name="SentenceCaseRadio"
            Classes="filter-editor-radio"
            GroupName="LettersCaseMode"
            Content="Sentence case"
            IsChecked="{Binding IsModeSentenceCase, Mode=TwoWay}"
          />
          <RadioButton
            x:Name="InvertCaseRadio"
            Classes="filter-editor-radio"
            GroupName="LettersCaseMode"
            Content="tOGGLE cASE"
            IsChecked="{Binding IsModeInvertCase, Mode=TwoWay}"
          />
          <RadioButton
            x:Name="UpperCaseRadio"
            Classes="filter-editor-radio"
            GroupName="LettersCaseMode"
            Content="UPPER CASE"
            IsChecked="{Binding IsModeUpperCase, Mode=TwoWay}"
          />
          <RadioButton
            x:Name="FirstLetterUpRadio"
            Classes="filter-editor-radio"
            GroupName="LettersCaseMode"
            Content="First letter up"
            IsChecked="{Binding IsModeFirstLetterUp, Mode=TwoWay}"
          />
          <RadioButton
            x:Name="WeirdCaseRadio"
            Classes="filter-editor-radio"
            GroupName="LettersCaseMode"
            Content="wEiRd CaSe"
            IsChecked="{Binding IsModeWeirdCase, Mode=TwoWay}"
          />
          <RadioButton
            x:Name="LowerCaseRadio"
            Classes="filter-editor-radio"
            GroupName="LettersCaseMode"
            Content="lower case"
            IsChecked="{Binding IsModeLowerCase, Mode=TwoWay}"
          />
        </UniformGrid>
        <StackPanel IsVisible="{Binding HasSkipWords}" Spacing="4">
          <TextBlock
            Classes="filter-editor-label"
            Text="Skip words (comma-separated, title case only):"
            TextWrapping="Wrap"
          />
          <TextBox x:Name="SkipWordsBox" Classes="filter-editor-field" Text="{Binding SkipWordsText}" />
        </StackPanel>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
