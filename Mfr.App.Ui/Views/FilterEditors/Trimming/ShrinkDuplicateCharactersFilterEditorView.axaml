<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="160"
  x:Class="Mfr.App.Ui.Views.FilterEditors.ShrinkDuplicateCharactersFilterEditorView"
  x:DataType="vm:ShrinkDuplicateCharactersFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock
          Classes="filter-editor-label"
          VerticalAlignment="Center"
          TextWrapping="Wrap"
          MaxWidth="280"
          Text="Replaces duplicate occurrences of the following character with a single occurrence:"
        />
        <TextBox
          x:Name="CharacterBox"
          Classes="filter-editor-field"
          Width="28"
          MaxLength="1"
          HorizontalContentAlignment="Center"
          VerticalAlignment="Center"
          Text="{Binding CharacterText}"
        />
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
