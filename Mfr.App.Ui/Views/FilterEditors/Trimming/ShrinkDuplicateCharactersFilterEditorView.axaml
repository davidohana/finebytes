<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Trimming"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="160"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Trimming.ShrinkDuplicateCharactersFilterEditorView"
  x:DataType="vm:ShrinkDuplicateCharactersFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <controls:LabelBesideFieldPanel ToolTip.Tip="Collapses runs of two or more of this character into one (e.g. --- → -). Empty box leaves the name unchanged.">
        <TextBlock
          Classes="filter-editor-label"
          TextWrapping="Wrap"
          Text="Replaces duplicate occurrences of the following character with a single occurrence:"
        />
        <TextBox
          x:Name="CharacterBox"
          Classes="filter-editor-field"
          Width="28"
          MaxLength="1"
          HorizontalContentAlignment="Center"
          Text="{Binding CharacterText}"
        />
      </controls:LabelBesideFieldPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
