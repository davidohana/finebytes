<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Case"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="200"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Case.CasingListFilterEditorView"
  x:DataType="vm:CasingListFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6">
        <StackPanel Spacing="4">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="One word per line." />
              <TextBlock
                Classes="rich-tip-body"
                Text="Matched words take the exact casing from the list; unknown words are left unchanged. Blank lines and //, \\, or # comments are ignored."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBlock Classes="filter-editor-label" Text="Words (one per line):" />
          <TextBox
            x:Name="WordsBox"
            MinHeight="88"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            FontFamily="{DynamicResource FileListFont}"
            FontSize="{DynamicResource FileListFontSize}"
            Foreground="{DynamicResource FileListForegroundBrush}"
            Background="{DynamicResource FileListRowBrush}"
            BorderBrush="{DynamicResource FileListAddressBarBorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="4,2"
            Watermark="and&#x0a;or&#x0a;with&#x0a;RMX"
            Text="{Binding WordsText}"
          />
        </StackPanel>
        <controls:CompactCheckBox
          x:Name="UppercaseSentenceInitialCheckBox"
          Content="Always uppercase first letter in sentence"
          IsChecked="{Binding UppercaseSentenceInitial}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock
                Classes="rich-tip-title"
                Text="Uppercase the first letter at the start of the segment and after sentence ends."
              />
              <TextBlock
                Classes="rich-tip-body"
                Text="Sentence-end characters come from Sentence End Characters earlier in the chain (default .!?). Place that filter before Casing List when you need custom boundaries."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactCheckBox>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
