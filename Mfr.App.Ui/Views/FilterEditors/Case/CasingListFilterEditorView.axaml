<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Case"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="120"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Case.CasingListFilterEditorView"
  x:DataType="vm:CasingListFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6">
        <StackPanel Spacing="4">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Space-separated words." />
              <TextBlock
                Classes="rich-tip-body"
                Text="Matched words take the exact casing from the list; unknown words are left unchanged."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBlock Classes="filter-editor-label" Text="Words:" />
          <TextBox
            x:Name="WordsBox"
            Classes="filter-editor-field-wrap"
            MinWidth="240"
            Watermark="and or with RMX"
            Text="{Binding WordsText}"
          />
        </StackPanel>
        <controls:CompactCheckBox
          x:Name="UppercaseSentenceInitialCheckBox"
          Content="Always uppercase first letter in sentence"
          IsChecked="{Binding UppercaseSentenceInitial}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock
                Classes="rich-tip-title"
                Text="Uppercase the first letter at the start of the segment and after sentence ends."
              />
              <TextBlock
                Classes="rich-tip-body"
                Text="Sentence-end characters come from Sentence End Characters earlier in the chain (default .!?). Place that filter before Casing List when you need custom boundaries."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactCheckBox>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
