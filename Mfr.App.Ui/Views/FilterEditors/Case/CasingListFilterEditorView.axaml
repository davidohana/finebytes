<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Case"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="120"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Case.CasingListFilterEditorView"
  x:DataType="vm:CasingListFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6">
        <StackPanel Spacing="4">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Text file with one word per line." />
              <TextBlock
                Classes="rich-tip-body"
                Text="Matched words take the exact casing from the file; unknown words are left unchanged. Blank lines and //, \\, or # comments are ignored."
              />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Use … to browse; Reload after editing the file externally."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBlock Classes="filter-editor-label" Text="Casing List file to use:" />
          <DockPanel LastChildFill="True">
            <Button
              x:Name="ReloadButton"
              DockPanel.Dock="Right"
              Margin="4,0,0,0"
              MinWidth="64"
              Height="22"
              Padding="8,0"
              VerticalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Content="Reload"
              Command="{Binding ReloadCommand}"
              IsEnabled="{Binding HasListFile}"
              ToolTip.Tip="Re-read the casing list from the selected file after external edits."
            />
            <Button
              x:Name="BrowseButton"
              DockPanel.Dock="Right"
              Margin="4,0,0,0"
              MinWidth="28"
              Height="22"
              Padding="4,0"
              VerticalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Content="…"
              Click="_BrowseButton_OnClick"
              ToolTip.Tip="Browse for a casing list file."
            />
            <TextBox
              x:Name="FilePathBox"
              Classes="filter-editor-field"
              MinWidth="160"
              Watermark="[Not Selected]"
              Text="{Binding FilePath}"
            />
          </DockPanel>
        </StackPanel>
        <controls:CompactCheckBox
          x:Name="UppercaseSentenceInitialCheckBox"
          Content="Always uppercase first letter in sentence"
          IsChecked="{Binding UppercaseSentenceInitial}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock
                Classes="rich-tip-title"
                Text="Uppercase the first letter at the start of the segment and after sentence ends."
              />
              <TextBlock
                Classes="rich-tip-body"
                Text="Sentence-end characters come from Sentence End Characters earlier in the chain (default .!?). Place that filter before Casing List when you need custom boundaries."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactCheckBox>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
