<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Case"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:converters="using:Mfr.App.Ui.Converters"
  xmlns:caseFilters="using:Mfr.Filters.Case"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="260"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Case.LettersCaseFilterEditorView"
  x:DataType="vm:LettersCaseFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Casing Style">
      <WrapPanel Orientation="Horizontal">
        <controls:CompactRadioButton
          x:Name="CapitalizeRadio"
          Margin="0,0,16,4"
          GroupName="LettersCaseMode"
          Content="Capitalize"
          IsChecked="{Binding Mode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static caseFilters:LettersCaseMode.Capitalize}, Mode=TwoWay}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock
                Classes="rich-tip-body"
                Text="First letter of each word uppercased; other letters lowercased."
              />
              <TextBlock Classes="rich-tip-bullet" Text="• Words use the current word separator." />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactRadioButton>
        <controls:CompactRadioButton
          x:Name="SentenceCaseRadio"
          Margin="0,0,16,4"
          GroupName="LettersCaseMode"
          Content="Sentence case"
          ToolTip.Tip="First letter of each sentence uppercased; other letters lowercased."
          IsChecked="{Binding Mode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static caseFilters:LettersCaseMode.SentenceCase}, Mode=TwoWay}"
        />
        <controls:CompactRadioButton
          x:Name="InvertCaseRadio"
          Margin="0,0,16,4"
          GroupName="LettersCaseMode"
          Content="tOGGLE cASE"
          ToolTip.Tip="Uppercase letters become lowercase and vice versa."
          IsChecked="{Binding Mode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static caseFilters:LettersCaseMode.InvertCase}, Mode=TwoWay}"
        />
        <controls:CompactRadioButton
          x:Name="UpperCaseRadio"
          Margin="0,0,16,4"
          GroupName="LettersCaseMode"
          Content="UPPER CASE"
          ToolTip.Tip="All letters uppercased."
          IsChecked="{Binding Mode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static caseFilters:LettersCaseMode.UpperCase}, Mode=TwoWay}"
        />
        <controls:CompactRadioButton
          x:Name="FirstLetterUpRadio"
          Margin="0,0,16,4"
          GroupName="LettersCaseMode"
          Content="First letter up"
          ToolTip.Tip="First letter uppercased; all other letters lowercased."
          IsChecked="{Binding Mode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static caseFilters:LettersCaseMode.FirstLetterUp}, Mode=TwoWay}"
        />
        <controls:CompactRadioButton
          x:Name="WeirdCaseRadio"
          Margin="0,0,16,4"
          GroupName="LettersCaseMode"
          Content="wEiRd CaSe"
          ToolTip.Tip="Mixed casing. Chance of uppercase is set in Weird Case Settings."
          IsChecked="{Binding Mode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static caseFilters:LettersCaseMode.WeirdCase}, Mode=TwoWay}"
        />
        <controls:CompactRadioButton
          x:Name="LowerCaseRadio"
          Margin="0,0,0,4"
          GroupName="LettersCaseMode"
          Content="lower case"
          ToolTip.Tip="All letters lowercased."
          IsChecked="{Binding Mode, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static caseFilters:LettersCaseMode.LowerCase}, Mode=TwoWay}"
        />
      </WrapPanel>
    </controls:FieldsetGroup>
    <controls:FieldsetGroup x:Name="SkipWordsGroup" Header="Skip Words" IsVisible="{Binding HasCapitalizeSkipWords}">
      <StackPanel Spacing="4">
        <ToolTip.Tip>
          <controls:RichToolTip>
            <TextBlock
              Classes="rich-tip-body"
              Text="In Capitalize mode, these words stay lowercase (matched case-insensitively)."
            />
            <TextBlock Classes="rich-tip-bullet" Text="• Example: a, an, the." />
          </controls:RichToolTip>
        </ToolTip.Tip>
        <TextBlock Classes="filter-editor-label" Text="Leave lowercase (comma-separated):" TextWrapping="Wrap" />
        <TextBox
          x:Name="CapitalizeSkipWordsBox"
          Classes="filter-editor-field-wrap"
          Text="{Binding CapitalizeSkipWordsText}"
        />
      </StackPanel>
    </controls:FieldsetGroup>
    <controls:FieldsetGroup
      x:Name="WeirdCaseSettingsGroup"
      Header="Weird Case Settings"
      IsVisible="{Binding HasWeirdCaseOptions}"
    >
      <StackPanel Orientation="Horizontal" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Chance each letter is uppercased." />
              <TextBlock Classes="rich-tip-bullet" Text="• 0 = all lower, 100 = all upper." />
              <TextBlock Classes="rich-tip-bullet" Text="• Other values mix case." />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBlock Classes="filter-editor-label" VerticalAlignment="Center" Text="Percent of capital letters:" />
          <controls:CompactNumericUpDown
            x:Name="WeirdUppercaseChanceSpinner"
            Width="56"
            Minimum="0"
            Maximum="100"
            Increment="1"
            FormatString="0"
            Value="{Binding WeirdUppercaseChancePercent}"
          />
          <TextBlock Classes="filter-editor-label" VerticalAlignment="Center" Text="%" />
        </StackPanel>
        <controls:CompactCheckBox
          x:Name="WeirdFixedPlacesCheckBox"
          Content="Fixed Places"
          IsChecked="{Binding WeirdFixedPlaces}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Checked: the same character positions get the same case across files."
              />
              <TextBlock Classes="rich-tip-bullet" Text="• Unchecked: each file’s list index changes the pattern." />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactCheckBox>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
