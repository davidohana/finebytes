<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Case"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="80"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Case.SentenceEndCharactersFilterEditorView"
  x:DataType="vm:SentenceEndCharactersFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <controls:LabelBesideFieldPanel ToolTip.Tip="Characters that end a sentence for Letters Case (sentence mode) and Casing List (sentence initials). This filter does not change the name text.">
        <TextBlock
          Classes="filter-editor-label"
          TextWrapping="Wrap"
          Text="The following characters indicate that a sentence had ended:"
        />
        <TextBox
          x:Name="CharsBox"
          Classes="filter-editor-field"
          MinWidth="120"
          MaxLength="100"
          Text="{Binding Characters}"
        />
      </controls:LabelBesideFieldPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
