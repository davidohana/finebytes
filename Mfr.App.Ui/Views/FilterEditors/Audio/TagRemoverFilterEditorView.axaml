<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Audio"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="220"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Audio.TagRemoverFilterEditorView"
  x:DataType="vm:TagRemoverFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6">
        <controls:CompactCheckBox
          x:Name="RemoveAllCheckBox"
          Content="Remove all embedded tags"
          IsChecked="{Binding RemoveAll}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Nuclear strip of every TagLib tag type." />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Clears all modeled blocks on preview, and on commit also removes unmodeled TagLib types (XMP, DivX, Matroska, …)."
              />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Unchecked: remove only the selected block types below (unmodeled types stay on disk)."
              />
              <TextBlock Classes="rich-tip-bullet" Text="• Tag removal cannot be undone with the app Undo control." />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactCheckBox>
        <TextBlock Classes="filter-editor-label" Text="Tag types to remove:" />
        <ItemsControl
          x:Name="BlockKindsItemsControl"
          ItemsSource="{Binding BlockRows}"
          IsEnabled="{Binding AreBlockTypesEnabled}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock
                Classes="rich-tip-body"
                Text="Select which modeled tag blocks to delete when not removing all tags."
              />
              <TextBlock Classes="rich-tip-bullet" Text="• At least one type is required in selective mode." />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Naming a block the file’s container cannot hold is a preview error."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TagRemoverBlockRowViewModel">
              <controls:CompactCheckBox
                Margin="0,0,16,4"
                Content="{Binding DisplayName}"
                IsChecked="{Binding IsSelected}"
                ToolTip.Tip="{Binding Tip}"
                Tag="{Binding Kind}"
              />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
