<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Audio"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="520"
  d:DesignHeight="180"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Audio.Id3v2FieldSetterFilterEditorView"
  x:DataType="vm:Id3v2FieldSetterFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
        <controls:FilterEditorLabeledRow Label="Set ID3v2 field:">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Which modeled ID3v2 text frame to write on MPEG/MP3 rows." />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Code in parentheses is the Frame ID; see ID3v2 Fields Reference for formats."
              />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Creates an ID3v2.3 tag when missing; existing tag versions are preserved."
              />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Add multiple instances of this filter to set several frames at once."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <ComboBox
            x:Name="FrameCombo"
            Classes="filter-editor-field"
            MinWidth="280"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding Frames}"
            SelectedItem="{Binding SelectedFrame}"
          />
        </controls:FilterEditorLabeledRow>
        <controls:FilterEditorLabeledRow Label="to:">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Value written to the selected frame." />
              <TextBlock
                Classes="rich-tip-body"
                Text="Plain text, or a formatter template when it contains tokens such as &lt;file-name&gt;. Empty clears the frame instance."
              />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Some frames need a specific format (e.g. Year as four digits)."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBox
            x:Name="TextBox"
            Classes="filter-editor-field"
            MinWidth="280"
            HorizontalAlignment="Stretch"
            Text="{Binding Text}"
          />
        </controls:FilterEditorLabeledRow>
        <controls:FilterEditorLabeledRow x:Name="LanguageRow" Label="Language:" IsVisible="{Binding ShowsLanguage}">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="ISO-639-2 language for COMM / USLT identity." />
              <TextBlock
                Classes="rich-tip-bullet"
                Text="• Leave empty for the primary instance (language eng on create)."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBox
            x:Name="LanguageBox"
            Classes="filter-editor-field"
            Width="72"
            MaxLength="3"
            HorizontalAlignment="Left"
            Watermark="eng"
            Text="{Binding Language}"
          />
        </controls:FilterEditorLabeledRow>
        <controls:FilterEditorLabeledRow
          x:Name="DescriptionRow"
          Label="Description:"
          IsVisible="{Binding ShowsDescription}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Content descriptor for COMM / USLT / TXXX identity." />
              <TextBlock Classes="rich-tip-bullet" Text="• Leave empty for the primary instance." />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBox
            x:Name="DescriptionBox"
            Classes="filter-editor-field"
            MinWidth="200"
            HorizontalAlignment="Stretch"
            Text="{Binding Description}"
          />
        </controls:FilterEditorLabeledRow>
        <controls:CompactCheckBox
          x:Name="OnlyIfEmptyCheckBox"
          Content="Set only if current value is empty"
          IsChecked="{Binding OnlyIfEmpty}"
        >
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock
                Classes="rich-tip-body"
                Text="When checked, set the frame only if its current preview value is empty or whitespace; otherwise overwrite."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
        </controls:CompactCheckBox>
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
