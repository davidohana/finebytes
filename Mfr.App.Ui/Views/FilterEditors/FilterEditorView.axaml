<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:editorVm="using:Mfr.App.Ui.ViewModels.FilterEditors"
  xmlns:local="using:Mfr.App.Ui.Views.FilterEditors"
  mc:Ignorable="d"
  d:DesignWidth="480"
  d:DesignHeight="280"
  x:Class="Mfr.App.Ui.Views.FilterEditors.FilterEditorView"
  x:DataType="editorVm:FilterEditorViewModel"
  FontFamily="{StaticResource FileListFont}"
  FontSize="{StaticResource FileListFontSize}"
  Foreground="{DynamicResource FileListForegroundBrush}"
>
  <UserControl.Styles>
    <Style Selector="Border.filter-editor-title-bar">
      <Setter Property="Background" Value="{DynamicResource FilterEditorTitleBarBrush}" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,0,4,0" />
    </Style>
    <Style Selector="TextBlock.filter-editor-title-bar">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource FilterEditorTitleBarForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.filter-editor-label">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.filter-editor-field, ComboBox.filter-editor-field">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListAddressBarBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.filter-editor-field">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.filter-editor-field /template/ ContentPresenter#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>
  <Border Classes="pane">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="filter-editor-title-bar">
        <TextBlock x:Name="AppliedFilterTitle" Classes="filter-editor-title-bar" Text="{Binding TitleText}" />
      </Border>
      <ScrollViewer>
        <StackPanel Margin="8,6,8,8" IsVisible="{Binding HasSelectedStep}" Spacing="8">
          <ContentControl x:Name="OptionsEditorSlot" Content="{Binding OptionsEditor}">
            <ContentControl.ContentTemplate>
              <local:FilterEditorViewLocator />
            </ContentControl.ContentTemplate>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
