<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:editorVm="using:Mfr.App.Ui.ViewModels.FilterEditors"
  xmlns:local="using:Mfr.App.Ui.Views.FilterEditors"
  xmlns:resources="using:Mfr.App.Ui.Resources"
  mc:Ignorable="d"
  d:DesignWidth="480"
  d:DesignHeight="280"
  x:Class="Mfr.App.Ui.Views.FilterEditors.FilterEditorView"
  x:Name="FilterEditorRoot"
  x:DataType="editorVm:FilterEditorViewModel"
  FontFamily="{StaticResource AppChromeFont}"
  FontSize="{StaticResource AppChromeFontSize}"
  Foreground="{DynamicResource AppChromeForegroundBrush}"
>
  <Border Classes="pane">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="filter-editor-title-bar" Classes.has-selection="{Binding HasSelectedStep}">
        <DockPanel>
          <Button
            x:Name="ShowFilterHelpButton"
            DockPanel.Dock="Right"
            Classes="filter-editor-title-bar-button"
            Content="?"
            ToolTip.Tip="{x:Static resources:AppTips.ShowFilterHelp}"
            IsVisible="{Binding HasSelectedStep}"
            Command="{Binding OpenSelectedFilterHelpCommand, ElementName=FilterEditorRoot}"
          />
          <Button
            x:Name="ResetFilterDefaultsButton"
            DockPanel.Dock="Right"
            Classes="filter-editor-title-bar-button"
            Content="↺"
            ToolTip.Tip="{x:Static resources:AppTips.ResetFilterDefaults}"
            IsVisible="{Binding HasSelectedStep}"
            Command="{Binding ResetSelectedToDefaultsCommand, ElementName=FilterEditorRoot}"
          />
          <Button
            x:Name="SaveFilterAsDefaultButton"
            DockPanel.Dock="Right"
            Classes="filter-editor-title-bar-button"
            Content="📌"
            ToolTip.Tip="{x:Static resources:AppTips.SaveFilterAsDefault}"
            IsVisible="{Binding HasSelectedStep}"
            Command="{Binding SaveSelectedAsDefaultCommand, ElementName=FilterEditorRoot}"
          />
          <TextBlock x:Name="AppliedFilterTitle" Classes="filter-editor-title-bar" Text="{Binding TitleText}" />
        </DockPanel>
      </Border>
      <TextBlock
        x:Name="EmptySelectionHint"
        Classes="filter-editor-empty-hint"
        Text="{x:Static editorVm:FilterEditorViewModel.EmptySelectionHint}"
        IsVisible="{Binding !HasSelectedStep}"
      />
      <ScrollViewer IsVisible="{Binding HasSelectedStep}">
        <StackPanel Margin="8,6,8,8" Spacing="8">
          <ContentControl x:Name="OptionsEditorSlot" Content="{Binding OptionsEditor}">
            <ContentControl.ContentTemplate>
              <local:FilterEditorViewLocator />
            </ContentControl.ContentTemplate>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
