<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:editorVm="using:Mfr.App.Ui.ViewModels.FilterEditors"
  xmlns:local="using:Mfr.App.Ui.Views.FilterEditors"
  mc:Ignorable="d"
  d:DesignWidth="480"
  d:DesignHeight="280"
  x:Class="Mfr.App.Ui.Views.FilterEditors.FilterEditorView"
  x:DataType="editorVm:FilterEditorViewModel"
  FontFamily="{StaticResource FileListFont}"
  FontSize="{StaticResource FileListFontSize}"
  Foreground="{DynamicResource FileListForegroundBrush}"
>
  <Border Classes="pane">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="filter-editor-title-bar">
        <TextBlock x:Name="AppliedFilterTitle" Classes="filter-editor-title-bar" Text="{Binding TitleText}" />
      </Border>
      <ScrollViewer>
        <StackPanel Margin="8,6,8,8" IsVisible="{Binding HasSelectedStep}" Spacing="8">
          <ContentControl x:Name="OptionsEditorSlot" Content="{Binding OptionsEditor}">
            <ContentControl.ContentTemplate>
              <local:FilterEditorViewLocator />
            </ContentControl.ContentTemplate>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
