<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Formatting"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="160"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Formatting.TokenMoverFilterEditorView"
  x:DataType="vm:TokenMoverFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
        <controls:FilterEditorLabeledRow Label="Token separator string:">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Substring that splits the name into tokens." />
              <TextBlock
                Classes="rich-tip-body"
                Text="For example, separator &quot;-&quot; splits Artist-Album-Title into three tokens."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <TextBox
            x:Name="DelimiterBox"
            Classes="filter-editor-field"
            Width="72"
            HorizontalAlignment="Left"
            MaxLength="50"
            Text="{Binding Delimiter}"
          />
        </controls:FilterEditorLabeledRow>
        <controls:FilterEditorLabeledRow Label="Token number to move:">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="One-based index of the token to move." />
              <TextBlock
                Classes="rich-tip-body"
                Text="Must not exceed the number of tokens in the segment; otherwise the name is left unchanged."
              />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <controls:CompactNumericUpDown
            x:Name="TokenNumberSpinner"
            Width="56"
            HorizontalAlignment="Left"
            Minimum="1"
            Maximum="1000"
            Increment="1"
            FormatString="0"
            Value="{Binding TokenNumber}"
          />
        </controls:FilterEditorLabeledRow>
        <controls:FilterEditorLabeledRow Label="Places to move:">
          <ToolTip.Tip>
            <controls:RichToolTip>
              <TextBlock Classes="rich-tip-title" Text="Distance and direction in token positions." />
              <TextBlock Classes="rich-tip-bullet" Text="• Positive moves toward the end; negative toward the start." />
              <TextBlock Classes="rich-tip-bullet" Text="• Example: -1 swaps with the preceding token." />
              <TextBlock Classes="rich-tip-bullet" Text="• Past the start or end clamps to the first or last slot." />
            </controls:RichToolTip>
          </ToolTip.Tip>
          <controls:CompactNumericUpDown
            x:Name="MoveBySpinner"
            Width="56"
            HorizontalAlignment="Left"
            Minimum="-999"
            Maximum="999"
            Increment="1"
            FormatString="0"
            Value="{Binding MoveBy}"
          />
        </controls:FilterEditorLabeledRow>
        <controls:FilterEditorHint Text="Negative value moves left." />
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
