<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.FilterEditors.Formatting"
  xmlns:controls="using:Mfr.App.Ui.Views.Controls"
  xmlns:converters="using:Mfr.App.Ui.Converters"
  xmlns:formattingFilters="using:Mfr.Filters.Formatting"
  mc:Ignorable="d"
  d:DesignWidth="420"
  d:DesignHeight="180"
  x:Class="Mfr.App.Ui.Views.FilterEditors.Formatting.InserterFilterEditorView"
  x:DataType="vm:InserterFilterEditorViewModel"
>
  <StackPanel Spacing="8">
    <controls:FieldsetGroup Header="Options">
      <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
        <StackPanel
          Spacing="4"
          ToolTip.Tip="Text inserted at the chosen position. May include formatter tokens such as &lt;Name&gt; when the string contains them."
        >
          <TextBlock Classes="filter-editor-label" Text="Insert the string:" />
          <TextBox
            x:Name="InsertTextBox"
            Classes="filter-editor-field"
            MinWidth="240"
            MaxLength="500"
            Text="{Binding InsertText}"
          />
        </StackPanel>
        <Grid ToolTip.Tip="One-based character index. Beginning: 1 inserts before the first character; past the end appends. End: 1 appends after the last character; 2 inserts before the last; a large position prepends.">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterEditorLabel" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="filter-editor-label" VerticalAlignment="Center" Text="At position:" />
          <controls:CompactNumericUpDown
            x:Name="PositionSpinner"
            Grid.Column="2"
            Width="56"
            HorizontalAlignment="Left"
            Minimum="1"
            Maximum="200"
            Increment="1"
            FormatString="0"
            Value="{Binding Position}"
          />
        </Grid>
        <Grid ToolTip.Tip="Direction to start counting the insert position from.">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FilterEditorLabel" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Classes="filter-editor-label" VerticalAlignment="Center" Text="Starting from:" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <controls:CompactRadioButton
              x:Name="BeginningRadio"
              GroupName="InserterOrigin"
              Content="Beginning"
              IsChecked="{Binding StartFrom, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static formattingFilters:InserterOrigin.Beginning}, Mode=TwoWay}"
            />
            <controls:CompactRadioButton
              x:Name="EndRadio"
              GroupName="InserterOrigin"
              Content="End"
              IsChecked="{Binding StartFrom, Converter={x:Static converters:EnumToBooleanConverter.Instance}, ConverterParameter={x:Static formattingFilters:InserterOrigin.End}, Mode=TwoWay}"
            />
          </StackPanel>
        </Grid>
        <controls:CompactCheckBox
          x:Name="OverwriteCheckBox"
          Content="Overwrite characters"
          ToolTip.Tip="When checked, inserted text replaces existing characters at the insert point instead of shifting them."
          IsChecked="{Binding Overwrite}"
        />
      </StackPanel>
    </controls:FieldsetGroup>
  </StackPanel>
</UserControl>
