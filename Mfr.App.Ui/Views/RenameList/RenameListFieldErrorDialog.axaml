<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Mfr.App.Ui.Views.RenameList.RenameListFieldErrorDialog"
  Title="Error"
  Icon="/Assets/mfr.ico"
  Width="520"
  MaxWidth="640"
  MinWidth="400"
  MaxHeight="520"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="True"
>
  <DockPanel Margin="16">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="8"
      Margin="0,12,0,0"
    >
      <Button x:Name="CopyButton" Content="Copy details" MinWidth="96" Click="_OnCopyDetailsClick" />
      <Button Content="OK" MinWidth="80" IsDefault="True" IsCancel="True" Click="_OnOkClick" />
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock
        Text="The original value for this field could not be read from disk."
        TextWrapping="Wrap"
        FontWeight="SemiBold"
      />
      <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" />
      <TextBlock Text="Technical details" FontWeight="SemiBold" Margin="0,4,0,0" />
      <TextBox
        x:Name="DetailsText"
        IsReadOnly="True"
        AcceptsReturn="True"
        TextWrapping="Wrap"
        MinHeight="48"
        MaxHeight="200"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      />
    </StackPanel>
  </DockPanel>
</Window>
