<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.RenameList"
  x:Class="Mfr.App.Ui.Views.RenameList.RenameListDisplayOptionsDialog"
  x:DataType="vm:RenameListDisplayOptionsDialogViewModel"
  Title="Rename List Display Options"
  Icon="/Assets/mfr.ico"
  Width="360"
  Height="160"
  MinWidth="320"
  MinHeight="140"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
  ShowInTaskbar="False"
>
  <DockPanel Margin="12">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Center"
      Spacing="12"
      Margin="0,12,0,0"
    >
      <Button
        Content="OK"
        MinWidth="80"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        IsDefault="True"
        Click="_OnOkClick"
      />
      <Button
        Content="Cancel"
        MinWidth="80"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        IsCancel="True"
        Click="_OnCancelClick"
      />
    </StackPanel>

    <CheckBox DockPanel.Dock="Top" IsChecked="{Binding UseFixedWidthFont}" Content="Use fixed-width font" />
  </DockPanel>
</Window>
