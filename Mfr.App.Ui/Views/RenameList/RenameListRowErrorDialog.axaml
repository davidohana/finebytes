<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Mfr.App.Ui.Views.RenameList.RenameListRowErrorDialog"
  Icon="/Assets/mfr.ico"
  Width="460"
  MinWidth="380"
  MaxWidth="520"
  MaxHeight="520"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  CanResize="True"
>
  <DockPanel Margin="20">
    <StackPanel
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Spacing="8"
      Margin="0,16,0,0"
    >
      <Button
        x:Name="CopyButton"
        Content="Copy details"
        MinWidth="104"
        HorizontalContentAlignment="Center"
        Click="_OnCopyDetailsClick"
      />
      <Button
        Content="OK"
        MinWidth="88"
        HorizontalContentAlignment="Center"
        IsDefault="True"
        IsCancel="True"
        Click="_OnOkClick"
      />
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock
        x:Name="FilePathText"
        TextWrapping="Wrap"
        Opacity="0.75"
        FontSize="12"
      />
      <TextBlock x:Name="UserMessageText" TextWrapping="Wrap" />
      <Expander
        x:Name="TechnicalDetailsExpander"
        Header="Technical details"
        IsExpanded="False"
        IsVisible="False"
        Margin="0,4,0,0"
      >
        <TextBox
          x:Name="TechnicalDetailsText"
          Margin="0,8,0,0"
          IsReadOnly="True"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          FontFamily="Consolas,Menlo,monospace"
          FontSize="12"
          MinHeight="88"
          MaxHeight="180"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        />
      </Expander>
    </StackPanel>
  </DockPanel>
</Window>
