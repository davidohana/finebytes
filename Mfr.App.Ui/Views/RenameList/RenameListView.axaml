<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.RenameList"
  xmlns:input="using:Mfr.App.Ui.Input"
  xmlns:resources="using:Mfr.App.Ui.Resources"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="240"
  x:Class="Mfr.App.Ui.Views.RenameList.RenameListView"
  x:DataType="vm:RenameListViewModel"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
      <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
      <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
      <Thickness x:Key="DataGridTextColumnCellTextBlockMargin">6,0,6,0</Thickness>
      <ContextMenu x:Key="RenameListRowContextMenu" x:Shared="False">
        <MenuItem
          Header="Locate in File List"
          Command="{Binding LocateInFileListCommand}"
          InputGesture="{x:Static input:AppShortcuts.LocateInFileList}"
        />
        <Separator />
        <MenuItem
          Header="Move Selected Up"
          Command="{Binding MoveSelectedUpCommand}"
          InputGesture="{x:Static input:AppShortcuts.MoveSelectedUp}"
        />
        <MenuItem
          Header="Move Selected Down"
          Command="{Binding MoveSelectedDownCommand}"
          InputGesture="{x:Static input:AppShortcuts.MoveSelectedDown}"
        />
        <Separator />
        <MenuItem
          Header="Select Fields..."
          Command="{Binding OpenFieldShuttleCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.SelectRenameListFields}"
        />
        <Separator />
        <MenuItem
          Header="Remove Selected Item(s)"
          Command="{Binding RemoveSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.RemoveSelectedDelete}"
        />
        <MenuItem
          Header="Remove All But Selected"
          Command="{Binding RemoveAllButSelectedCommand}"
          InputGesture="{x:Static input:AppShortcuts.RemoveAllButSelected}"
        />
        <MenuItem
          Header="Remove All"
          Command="{Binding ClearCommand}"
          InputGesture="{x:Static input:AppShortcuts.ClearRenameList}"
        />
      </ContextMenu>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="DataGrid.rename-list">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="RowBackground" Value="{DynamicResource FileListRowBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ColumnHeaderHeight" Value="22" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="DataGrid.rename-list /template/ ScrollBar#PART_VerticalScrollbar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="DataGrid.rename-list /template/ ScrollBar#PART_HorizontalScrollbar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridColumnHeader">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource FileListHeaderForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource FileListHeaderBrush}" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,0,4,0" />
      <Setter Property="SeparatorBrush" Value="{DynamicResource FileListSeparatorBrush}" />
      <Setter Property="AreSeparatorsVisible" Value="True" />
    </Style>
    <Style Selector="TextBlock.rename-list-preview-header">
      <Setter Property="Foreground" Value="Red" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridColumnHeader /template/ Path#SortIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.rename-list-sort-glyph">
      <Setter Property="Background" Value="{DynamicResource FileListSortGlyphBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSortGlyphBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rename-list-sort-glyph TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListSortGlyphFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListSortGlyphForegroundBrush}" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource FileListRowBrush}" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow:nth-child(even)">
      <Setter Property="Background" Value="{DynamicResource FileListAltRowBrush}" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridCell">
      <Setter Property="FontFamily" Value="{StaticResource FileListFont}" />
      <Setter Property="FontSize" Value="{StaticResource FileListFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource FileListForegroundBrush}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridCell:focus /template/ Grid#FocusVisual">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource FileListSelectionBorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- MFR7 MarkedRow (Color.Salmon) while dragging over a row (files or internal reorder) -->
    <Style Selector="DataGrid.rename-list DataGridRow.drop-mark">
      <Setter Property="Background" Value="#FA8072" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow.drop-mark /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#FA8072" />
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGrid.rename-list DataGridRow.drop-mark:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#FA8072" />
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.rename-list-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rename-list-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.rename-list-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
    <Style Selector="Button.rename-list-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
    </Style>
    <Style Selector="Button.rename-list-action:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="ToggleButton.rename-list-action">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.rename-list-action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.rename-list-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.rename-list-action:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
    </Style>
    <Style Selector="ToggleButton.rename-list-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FileListSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FileListSelectionBorderBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="pane">
    <Grid ColumnDefinitions="Auto,*">
      <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="0" Margin="4,0,4,4">
        <Button
          Classes="rename-list-action"
          Command="{Binding AddSelectedCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.AddSelected}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/AddSelected.png" />
        </Button>
        <Button
          Classes="rename-list-action"
          Command="{Binding AddAllCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.AddAll}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/AddAll.png" />
        </Button>
        <Button
          Classes="rename-list-action"
          Command="{Binding RemoveSelectedCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.RemoveSelected}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/RemoveSelected.png" />
        </Button>
        <Button
          Classes="rename-list-action"
          Command="{Binding ClearCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.ClearRenameList}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/Clear.png" />
        </Button>
        <Button
          Classes="rename-list-action"
          Command="{Binding MoveSelectedUpCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.MoveSelectedUp}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveUp.png" />
        </Button>
        <Button
          Classes="rename-list-action"
          Command="{Binding MoveSelectedDownCommand}"
          ToolTip.Tip="{x:Static resources:AppTips.MoveSelectedDown}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/MoveDown.png" />
        </Button>
        <ToggleButton
          Classes="rename-list-action"
          IsChecked="{Binding IsAutoSort, Mode=OneWay}"
          Command="{Binding ToggleAutoSortCommand}"
          ToolTip.Tip="{Binding SortSummaryText}"
        >
          <Image Width="24" Height="24" Stretch="None" Source="/Assets/RenameList/AutoSort.png" />
        </ToggleButton>
      </StackPanel>
      <DataGrid
        x:Name="RenameGrid"
        Grid.Column="1"
        Classes="rename-list"
        ItemsSource="{Binding Entries}"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        CanUserReorderColumns="False"
        CanUserSortColumns="True"
        CanUserResizeColumns="True"
        HeadersVisibility="Column"
        GridLinesVisibility="None"
        RowHeight="20"
        ColumnHeaderHeight="22"
        SelectionMode="Extended"
        Sorting="_OnEntriesSorting"
        ContextMenu="{StaticResource RenameListRowContextMenu}"
      >
        <DataGrid.Columns />
      </DataGrid>
    </Grid>
  </Border>
</UserControl>
