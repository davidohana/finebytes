<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.RenameList"
  x:Class="Mfr.App.Ui.Views.RenameList.RenameListProgressDialog"
  x:DataType="vm:RenameListProgressViewModel"
  Title="{Binding DialogTitle}"
  Icon="/Assets/mfr.ico"
  Width="560"
  Height="254"
  MinWidth="520"
  MinHeight="234"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
  ShowInTaskbar="False"
>
  <DockPanel Margin="16">
    <Button
      DockPanel.Dock="Bottom"
      Content="Cancel"
      MinWidth="80"
      HorizontalAlignment="Center"
      HorizontalContentAlignment="Center"
      VerticalContentAlignment="Center"
      Margin="0,16,0,0"
      IsCancel="True"
      Command="{Binding CancelCommand}"
    />

    <StackPanel Spacing="12" VerticalAlignment="Center">
      <TextBlock
        HorizontalAlignment="Center"
        IsVisible="{Binding ShowResolveProgress}"
        Text="{Binding PrimaryProgressText}"
      />
      <TextBlock
        HorizontalAlignment="Center"
        IsVisible="{Binding ShowResolveProgress}"
        Text="{Binding SecondaryProgressText}"
      />
      <TextBlock
        HorizontalAlignment="Center"
        IsVisible="{Binding ShowMetadataProgress}"
        Text="{Binding MetadataProgressText}"
      />
      <ProgressBar
        Minimum="0"
        Maximum="{Binding MetadataTotalCount}"
        Value="{Binding MetadataProcessedCount}"
        IsVisible="{Binding ShowProgressBar}"
        Height="16"
      />
      <TextBlock
        HorizontalAlignment="Stretch"
        TextWrapping="Wrap"
        TextAlignment="Center"
        MinHeight="60"
        MaxHeight="72"
        Text="{Binding LastPath}"
      />
    </StackPanel>
  </DockPanel>
</Window>
