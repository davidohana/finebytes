<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Mfr.App.Ui.ViewModels.RenameList"
  x:Class="Mfr.App.Ui.Views.RenameList.AddProgressDialog"
  x:DataType="vm:RenameListViewModel"
  Title="Adding to Rename List"
  Icon="/Assets/mfr.ico"
  Width="560"
  Height="210"
  MinWidth="520"
  MinHeight="190"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
  ShowInTaskbar="False"
>
  <DockPanel Margin="16">
    <Button
      DockPanel.Dock="Bottom"
      Content="Cancel"
      MinWidth="80"
      HorizontalAlignment="Center"
      HorizontalContentAlignment="Center"
      VerticalContentAlignment="Center"
      Margin="0,16,0,0"
      IsCancel="True"
      Command="{Binding CancelAddCommand}"
    />

    <StackPanel Spacing="12" VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center" Text="{Binding AddScannedCount, StringFormat=Scanned {0} files}" />
      <TextBlock HorizontalAlignment="Center" Text="{Binding AddAddedCount, StringFormat=Added {0} files}" />
      <TextBlock
        HorizontalAlignment="Stretch"
        TextWrapping="Wrap"
        TextAlignment="Center"
        MinHeight="60"
        MaxHeight="72"
        Text="{Binding AddLastPath}"
      />
    </StackPanel>
  </DockPanel>
</Window>
